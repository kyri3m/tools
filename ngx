def cmd_top(a):
    files = log_files(load(a.name), 'access') if a.name else glob.glob(f'{LOG}/ngx-*.access.log')
    m = re.fullmatch(r'([1-9][0-9]*)([mhd])', a.since)
    if not m:
        raise Fail('--since 格式：30m、6h、1d')
    cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=int(m[1]) * {'m': 60, 'h': 3600, 'd': 86400}[m[2]])
    pattern = re.compile(r'(\S+) \S+ \S+ \[([^]]+)\] "(?:\S+) (\S+)[^"]*" (\d{3}) (\d+)')
    rows = []
    for f in files:
        try:
            with open(f, errors='replace') as stream:
                for line in stream:
                    x = pattern.match(line)
                    if not x:
                        continue
                    try:
                        t = datetime.datetime.strptime(x[2], '%d/%b/%Y:%H:%M:%S %z')
                    except ValueError:
                        continue
                    if t >= cutoff:
                        rows.append((x[1], x[3].split('?')[0], x[4], int(x[5])))
        except OSError:
            pass
    total = sum(r[3] for r in rows)
    title(f'最近 {a.since}：{len(rows)} 个请求，{human(total)}')
    import collections
    for label, idx in (('状态码', 2), ('来源 IP', 0), ('路径', 1)):
        print(f'\n  {bold(label)}')
        for value, count in collections.Counter(r[idx] for r in rows).most_common(8):
            print(f'    {count:>7}  {value}')

def human(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1024:
            return f'{n:.0f} {unit}' if unit == 'B' else f'{n:.1f} {unit}'
        n /= 1024
    return f'{n:.1f} PB'

