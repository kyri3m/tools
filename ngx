def log_files(site, kind):
    if site['type'] == 'external':
        return [p for p in site.get(kind + '_logs', []) if os.path.exists(p)] or [f'{LOG}/{kind}.log']
    return [f'{LOG}/ngx-{site["name"]}.{kind}.log']

def cmd_logs(a):
