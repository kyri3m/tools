  ngx test | reload | restart

  全局选项：-y/--yes 跳过确认   --open-firewall 自动放行防火墙端口
'''

def build_parser():
    p = argparse.ArgumentParser(prog='ngx', add_help=False)
    p.add_argument('-y', '--yes', action='store_true')
    p.add_argument('--open-firewall', action='store_true')
    p.add_argument('-h', '--help', action='store_true')
    p.add_argument('-V', '--version', action='store_true')
    sub = p.add_subparsers(dest='cmd')
    def cmd(name, *aliases):
        c = sub.add_parser(name, aliases=list(aliases), add_help=False)
        c.add_argument('-y', '--yes', action='store_true', dest='yes_sub')
        c.add_argument('--open-firewall', action='store_true', dest='open_sub')
        return c
    c = cmd('add')
    c.add_argument('domain'); c.add_argument('backend')
    c.add_argument('--name'); c.add_argument('--port'); c.add_argument('--no-tls', action='store_true')
    c.add_argument('--proxied', '--cloudflare', action='store_true'); c.add_argument('--cf-only', action='store_true')
    c.add_argument('--no-dns', action='store_true'); c.add_argument('--no-headers', action='store_true')
    c.add_argument('--email'); c.add_argument('--dns', action='store_true'); c.add_argument('--http', action='store_true')
    cmd('ls', 'list'); cmd('status'); cmd('scan')
    c = cmd('show'); c.add_argument('name'); c.add_argument('--config', action='store_true')
    c = cmd('set'); c.add_argument('name'); c.add_argument('field'); c.add_argument('value')
    c = cmd('route'); c.add_argument('name'); c.add_argument('action', choices=['ls', 'add', 'rm'])
    c.add_argument('path', nargs='?'); c.add_argument('backend', nargs='?')
    c = cmd('auth'); c.add_argument('name'); c.add_argument('action', choices=['set', 'off']); c.add_argument('user', nargs='?')
    c = cmd('allow'); c.add_argument('name'); c.add_argument('action', choices=['add', 'rm', 'ls', 'clear']); c.add_argument('cidr', nargs='?')
    for n in ('enable', 'disable', 'edit', 'forget'):
        cmd(n).add_argument('name')
    c = cmd('rm', 'remove'); c.add_argument('name'); c.add_argument('--purge-cert', action='store_true'); c.add_argument('--dns', action='store_true')
    c = cmd('cert'); c.add_argument('action', choices=['issue', 'renew', 'list', 'rm']); c.add_argument('name', nargs='?')
    c.add_argument('--force', action='store_true'); c.add_argument('--dns', action='store_true'); c.add_argument('--http', action='store_true')
    c.add_argument('--dry-run', action='store_true')
    c = cmd('cf'); c.add_argument('action', choices=['token', 'update', 'proxied'])
    c.add_argument('sub', nargs='?'); c.add_argument('value', nargs='?')
    c = cmd('dns'); c.add_argument('action', choices=['ls', 'list', 'point', 'add', 'rm'])
    c.add_argument('name', nargs='?'); c.add_argument('type', nargs='?'); c.add_argument('content', nargs='?')
    c.add_argument('--proxied'); c.add_argument('--ttl', type=int, default=1); c.add_argument('--priority', type=int)
    c.add_argument('--id'); c.add_argument('--all', action='store_true')
    c = cmd('logs'); c.add_argument('name', nargs='?'); c.add_argument('-f', '--follow', action='store_true')
    c.add_argument('--error', action='store_true'); c.add_argument('-n', type=int, default=50)
    c = cmd('top'); c.add_argument('name', nargs='?'); c.add_argument('--since', default='1d')
    c = cmd('doctor'); c.add_argument('--fix', action='store_true')
    c = cmd('install'); c.add_argument('--email')
    c = cmd('backup'); c.add_argument('--with-keys', action='store_true')
    c = cmd('restore'); c.add_argument('file')
    c = cmd('adopt'); c.add_argument('--dry-run', action='store_true')
    for n in ('test', 'reload', 'restart', 'help', '_dns-auth', '_dns-cleanup'):
        cmd(n)
    return p

class ArgError(Exception):
    pass

def main(argv):
    global YES, OPEN_FW
    if os.geteuid() != 0 and not ROOT:
        raise Fail('需要 root 权限运行（sudo ngx）')
    if ROOT and not re.fullmatch(r'/[\w./-]+', ROOT):
        raise Fail('NGX_ROOT 必须是安全的绝对路径')
    parser = build_parser()
    parser.error = lambda msg: (_ for _ in ()).throw(ArgError(msg))
    for sp in parser._subparsers._group_actions[0].choices.values():
        sp.error = parser.error
    try:
        a = parser.parse_args(argv)
    except ArgError as e:
        m = re.search(r"invalid choice: '([^']*)'", str(e))
        msg = f'未知命令：{m[1]}' if m and 'argument cmd' in str(e) else str(e).replace('the following arguments are required', '缺少参数').replace('unrecognized arguments', '无法识别的参数').replace('invalid choice', '无效选项')
        err(msg)
        hint('ngx help 查看用法')
        raise SystemExit(2)
    YES = a.yes or getattr(a, 'yes_sub', False)
    OPEN_FW = a.open_firewall or getattr(a, 'open_sub', False)
    if a.version:
        print(VERSION)
        return
    if a.help or a.cmd == 'help':
        print(HELP)
        return
    if a.cmd in ('_dns-auth', '_dns-cleanup'):
        dns_hook(a.cmd)
        return
    if a.cmd != 'install':
        if not shutil.which('nginx') and not ROOT:
            raise Fail('还没安装 nginx：先运行 ngx install')
        migrate_legacy()
    handlers = {
        None: lambda: menu() if sys.stdin.isatty() else print(HELP),
        'add': lambda: cmd_add(a), 'ls': lambda: cmd_ls(a), 'list': lambda: cmd_ls(a), 'status': lambda: cmd_status(a),
        'scan': lambda: cmd_scan(a), 'show': lambda: cmd_show(a), 'set': lambda: cmd_set(a), 'route': lambda: cmd_route(a),
        'auth': lambda: cmd_auth(a), 'allow': lambda: cmd_allow(a), 'enable': lambda: cmd_toggle(a, True),
        'disable': lambda: cmd_toggle(a, False), 'edit': lambda: cmd_edit(a), 'forget': lambda: cmd_forget(a),
        'rm': lambda: cmd_rm(a), 'remove': lambda: cmd_rm(a), 'cert': lambda: cmd_cert(a), 'cf': lambda: cmd_cf(a),
        'dns': lambda: cmd_dns(dict_action(a)), 'logs': lambda: cmd_logs(a), 'top': lambda: cmd_top(a),
        'doctor': lambda: cmd_doctor(a), 'install': lambda: cmd_install(a), 'backup': lambda: cmd_backup(a),
        'restore': lambda: cmd_restore(a), 'adopt': lambda: cmd_adopt(a),
        'test': lambda: (nginx_test(), ok('nginx 配置正确')),
        'reload': lambda: (nginx_test(), nginx_reload(), ok('已重新加载')),
        'restart': lambda: (nginx_test(), sys_cmd(['systemctl', 'restart', 'nginx']), ok('已重启')),
    }
    handlers[a.cmd]()

def dict_action(a):
    if a.action == 'list':
        a.action = 'ls'
    if a.action in ('point',) and not a.name:
        raise Fail('用法：ngx dns point <域名|网站> [--proxied on|off]')
    if a.action == 'add' and not (a.name and a.type and a.content):
        raise Fail('用法：ngx dns add <名称> <类型> <内容>')
    if a.action == 'rm' and not a.name:
        raise Fail('用法：ngx dns rm <名称> [类型] [--id ID]')
    return a

if __name__ == '__main__':
    sys.stdout.reconfigure(line_buffering=True)
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        main(sys.argv[1:])
    except Fail as e:
        err(str(e))
        sys.exit(1)
