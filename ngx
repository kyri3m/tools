main() {
    local args=() arg cmd
    for arg in "$@"; do
        case $arg in --open-firewall) OPEN=1;; --yes) YES=1;; --purge-cert) PURGE=1;; --with-keys) WITH_KEYS=1;; *) args+=("$arg");; esac
    done
    set -- "${args[@]}"
    cmd=${1:-}; (($#)) && shift
    if [[ $cmd != adopt ]] && ! adopt_engine scan; then
        case $cmd in help|-h|--help) warn '当前环境无法自动登记站点，仍显示帮助；可在可写环境执行 ngx adopt';; *) return 1;; esac
    fi
    case $cmd in status|doctor|add|set|convert|cert)
        CF_PUBLIC4=$(curl -4 -fsS --max-time 8 https://api.ipify.org) || CF_PUBLIC4=''
        CF_PUBLIC6=$(curl -6 -fsS --max-time 8 https://api6.ipify.org) || CF_PUBLIC6=''
        ;;
    esac
    case $cmd in
        '') menu;; help|-h|--help) help_text;; status) status;; install) install_ngx;;
        add) add_site "$@";; edit|rm|enable|disable|set) change_site "$cmd" "$@";;
        show) load_site "${1:-}" && nl -ba "$(site_file)";;
        cf) [[ ${1:-} == update && $# == 1 ]] && cf_update;;
        adopt) [[ $# == 0 || $# == 1 && $1 == --dry-run ]] && adopt_engine scan "${1:-}";;
        convert) convert_site "$@";;
        cert) cert_command "$@";; test) ngtest;;
        reload) begin && finish;;
        restart) begin && ngtest && service_cmd systemctl restart nginx && finish;;
        logs) logs "$@";; top) top_stats "$@";; backup) backup;; restore) restore "$@";; doctor) doctor;;
        *) err "未知命令：$cmd"; help_text; return 1;;
    esac
}
# ---------- Cloudflare ----------
cf_validate() {
    python3 - "$@" <<'PY'
import ipaddress,sys
try:
    networks=[]
    for index,path in enumerate(sys.argv[1:]):
        lines=open(path).read().splitlines()
        if not lines: raise ValueError('地址列表为空')
        for line in lines:
            if not line or line!=line.strip() or '/' not in line: raise ValueError('每行必须是 CIDR')
            net=ipaddress.ip_network(line,strict=True)
            if len(sys.argv)==3 and net.version!=(4 if index==0 else 6): raise ValueError('地址族错误')
            if net.prefixlen==0: raise ValueError('不允许信任整个互联网')
            networks.append(net)
    networks=list(dict.fromkeys(networks))
    if sum(n.version==4 for n in networks)<10 or not any(n.version==6 for n in networks):
        raise ValueError('至少需要 10 条不同 IPv4 范围和 1 条 IPv6 范围')
    print('\n'.join(map(str,networks)))
except (OSError,ValueError) as e:
    print('Cloudflare 地址校验失败：'+str(e),file=sys.stderr); sys.exit(1)
PY
}
cf_update() {
    begin || return 1
    curl --proto '=https' -fsS --max-time 30 https://www.cloudflare.com/ips-v4 > "$TX/cf4" &&
    curl --proto '=https' -fsS --max-time 30 https://www.cloudflare.com/ips-v6 > "$TX/cf6" &&
    cf_validate "$TX/cf4" "$TX/cf6" > "$TX/cf.valid" || return 1
    mkdir -p "$STATE" "$ETC/conf.d" "$ETC/snippets" || return 1
    cp "$TX/cf.valid" "$STATE/cloudflare-ips.txt" || return 1
    local range
    {
        echo '# managed-by: ngx'
        while read -r range; do printf 'set_real_ip_from %s;\n' "$range"; done < "$STATE/cloudflare-ips.txt"
        echo 'real_ip_header CF-Connecting-IP;'
        echo 'real_ip_recursive on;'
        echo 'geo $realip_remote_addr $ngx_cf_peer {'
        echo '    default 0;'
        while read -r range; do printf '    %s 1;\n' "$range"; done < "$STATE/cloudflare-ips.txt"
        echo '}'
    } > "$ETC/conf.d/ngx-cloudflare-realip.conf" || return 1
    {
        echo '# managed-by: ngx'
        while read -r range; do printf 'allow %s;\n' "$range"; done < "$STATE/cloudflare-ips.txt"
        echo 'deny all;'
    } > "$ETC/snippets/ngx-cloudflare-allow.conf" || return 1
    finish
}
cf_acl() {
    [[ ${CF_ONLY:-off} == on ]] || return 0
    printf '    include %s/snippets/ngx-cloudflare-allow.conf;\n' "$ETC"
}
cf_gate() {
    [[ ${CF_ONLY:-off} == on ]] || return 0
    cat <<'GATE'
        # realip 已改写 $remote_addr；用原始连接地址进行来源验证。
        # 覆盖 server 的地址 ACL，防止将真实客户端误当作非 CF 来源。
        allow all;
        if ($ngx_cf_peer = 0) { return 403; }
GATE
}
cf_detect() {
    local addresses public4 public6
    addresses=$(getent ahosts "$1" 2>/dev/null | awk '{print $1}' | sort -u)
    public4=${CF_PUBLIC4:-}; public6=${CF_PUBLIC6:-}
    python3 - "$STATE/cloudflare-ips.txt" "$addresses" "$public4" "$public6" <<'PY'
import sys,ipaddress
cache,addresses,v4,v6=sys.argv[1:]
try: networks=[ipaddress.ip_network(x) for x in open(cache).read().splitlines()]
except (OSError,ValueError): networks=[]
try: ips=[ipaddress.ip_address(x) for x in addresses.split()]
except ValueError: ips=[]
public=[]
for value in (v4,v6):
    try: public.append(ipaddress.ip_address(value))
    except ValueError: pass
if ips and networks and all(any(ip in net for net in networks) for ip in ips): print('橙云')
elif ips and all(ip in public for ip in ips): print('灰云')
else: print('其他')
PY
}
cf_display() {
    local domain
    for domain in ${DOMAINS//,/ }; do hint "$domain：$(cf_detect "$domain")"; done
}
cf_warnings() {
    local domain cloud
    for domain in ${DOMAINS//,/ }; do
        cloud=$(cf_detect "$domain")
        case $cloud in
            橙云)
                [[ ${CLOUDFLARE:-off} == on ]] || warn "$domain：橙云但 cloudflare 模式关闭，请 ngx set $NAME cloudflare on（接管站点需先 convert）"
                case $PORT in 443|2053|2083|2087|2096|8443) ;; *) warn "$domain：橙云不代理 HTTPS 端口 $PORT；可用 443、2053、2083、2087、2096、8443";; esac
                if [[ $TYPE == emby ]]; then
                    warn "$domain：Cloudflare 条款限制通过免费 CDN 传送大量视频；建议为播放节点建立灰云子域 play.$domain，类型 emby，上游 $UPSTREAM"
                fi
                hint "$domain：Cloudflare SSL 模式必须为 Full (strict)" ;;
            灰云) [[ ${CLOUDFLARE:-off} != on ]] || hint "$domain：cloudflare 模式开启但当前灰云，无害；--cf-only 会拒绝直接访问" ;;
        esac
    done
    return 0
}
install_cf_timer() {
    local dir=$ROOT/etc/systemd/system
    [[ $SELF =~ ^/[a-zA-Z0-9_./-]+$ ]] || { err 'systemd 服务要求 ngx 可执行文件路径不含特殊字符'; return 1; }
