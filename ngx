def ensure_nginx_includes():
    """RHEL 系的 nginx.conf 没有 sites-enabled；补一行 include。"""
    conf = f'{ETC}/nginx.conf'
    text = read(conf)
    if text and 'sites-enabled' not in text:
        new = re.sub(r'(\n\s*include\s+\S*conf\.d/\*\.conf;)', r'\1\n    include ' + ETC + '/sites-enabled/*;', text, count=1)
        if new != text:
            shutil.copy2(conf, conf + '.ngx-bak')
            write(conf, new)
            ok('已在 nginx.conf 中加入 sites-enabled')

def tune_nginx_conf():
    """发行版默认 worker_connections 偏小（Debian 768）；只调高，不调低。"""
    conf = f'{ETC}/nginx.conf'
    text = read(conf)
    if not text:
        return
    new = text
    m = re.search(r'^(\s*)worker_connections\s+(\d+)\s*;', new, re.M)
    if m and int(m.group(2)) < 65535:
        new = new[:m.start()] + m.group(1) + 'worker_connections 65535;' + new[m.end():]
    elif not m:
        new = re.sub(r'events\s*\{', 'events {\n    worker_connections 65535;', new, count=1)
    if not re.search(r'^\s*worker_rlimit_nofile\b', new, re.M):
        new, n = re.subn(r'^(\s*worker_processes\b[^;]*;)', r'\1\nworker_rlimit_nofile 1048576;', new, count=1, flags=re.M)
        if not n:
            new = 'worker_rlimit_nofile 1048576;\n' + new
    if new != text:
        shutil.copy2(conf, conf + '.ngx-bak')
        write(conf, new)
        ok('已调高 nginx 连接数上限（worker_connections 65535，worker_rlimit_nofile 1048576）')

def cmd_backup(a):
    os.makedirs(BACK, mode=0o700, exist_ok=True)
    dest = f'{BACK}/ngx-{datetime.datetime.now().strftime("%Y%m%d-%H%M%S")}.tar.gz'
    with tarfile.open(dest, 'w:gz') as t:
        for p in sorted(managed_paths()):
            rel = p[len(ROOT):].lstrip('/')
            if not a.with_keys and p == TOKEN:
                continue
            t.add(p, arcname=rel, recursive=False)
        if a.with_keys and os.path.isdir(LE):
            t.add(LE, arcname=LE[len(ROOT):].lstrip('/'))
    os.chmod(dest, 0o600)
    ok(f'备份已保存：{dest}')
    hint('包含网站、自定义片段和 nginx 配置' + ('、证书私钥和 Token' if a.with_keys else '；不含证书和 Token（换机器请加 --with-keys）'))

def cmd_restore(a):
    if not os.path.isfile(a.file):
        raise Fail('备份文件不存在')
    allowed = ('etc/ngx/', 'etc/nginx/sites-available/', 'etc/nginx/sites-enabled/', 'etc/nginx/snippets/ngx-',
               'etc/nginx/conf.d/ngx-', 'etc/letsencrypt/', 'etc/systemd/system/ngx-')
    with tarfile.open(a.file, 'r:gz') as t:
        members = t.getmembers()
        for m in members:
            if m.name.startswith('/') or '..' in m.name.split('/') or not (m.isfile() or m.isdir() or m.issym()):
                raise Fail(f'备份含不安全条目：{m.name}')
            if not m.name.startswith(allowed) and m.name not in ('etc/letsencrypt', 'etc/nginx/ngx-default.disabled'):
                raise Fail(f'备份含不该恢复的文件：{m.name}')
            if m.issym():
                target = m.linkname[len(ROOT):] if m.linkname.startswith(ROOT + '/') else m.linkname
                target = os.path.normpath(target if target.startswith('/') else '/' + os.path.join(os.path.dirname(m.name), target))
                if not target.startswith(('/etc/nginx/', '/etc/letsencrypt/')):
                    raise Fail(f'备份含可疑链接：{m.name} → {m.linkname}')
        if not any(m.name.startswith('etc/ngx/sites/') for m in members):
            raise Fail('这不是 ngx 备份')
        if not confirm('用这个备份覆盖当前网站配置？', default=False):
            raise Fail('已取消')
        with Tx() as tx:
            for p in managed_paths():
                if not p.startswith(TOKEN) and os.path.lexists(p) and (p.startswith(STATE) or os.path.basename(p).startswith('ngx-')):
                    os.unlink(p)
            kwargs = {'filter': 'fully_trusted'} if hasattr(tarfile, 'data_filter') else {}
            t.extractall(ROOT or '/', members=members, **kwargs)
            layout()
            tx.commit()
    ok('已恢复；ngx doctor 检查证书是否齐全')

def cmd_adopt(a):
    """把手写的 nginx 站点登记为“手写配置”网站：可查看、启停、看日志，不改文件内容。"""
    known = {os.path.realpath(s.get('file', '')) for s in all_sites()}
    found = 0
    for folder in ('sites-enabled', 'sites-available', 'conf.d'):
        for p in sorted(glob.glob(f'{ETC}/{folder}/*')):
            real = os.path.realpath(p)
            base = os.path.basename(p)
            if base.startswith('ngx-') or base == 'default' or real in known or not os.path.isfile(real):
                continue
            if folder == 'conf.d' and not p.endswith('.conf'):
                continue
            text = read(real)
            if MARK in text or 'server' not in text:
                continue
            domains = []
            for m in re.finditer(r'^\s*server_name\s+([^;]+);', text, re.M):
                domains += [d for d in m[1].split() if d != '_' and host_valid(d, wildcard=True)]
            certs = re.findall(r'^\s*ssl_certificate\s+(/\S+);', text, re.M)
            logs = lambda key: [m for m in re.findall(rf'^\s*{key}\s+(/\S+)', text, re.M)]
            links = [l for l in glob.glob(f'{ETC}/sites-enabled/*') if os.path.realpath(l) == real and l != real]
            name = default_name(re.sub(r'\.conf$', '', base))
            site = dict(type='external', file=real, links=links, domains=list(dict.fromkeys(domains)),
                        cert=ROOT + certs[0] if certs and not certs[0].startswith(ROOT + '/') else certs[0] if certs else '',
                        access_logs=logs('access_log'), error_logs=logs('error_log'), name=name)
            known.add(real)
            found += 1
            if a.dry_run:
                print(f'  预览：{name} ← {real}')
            else:
                save(site)
                ok(f'已登记 {name} ← {real}（手写配置，ngx 不改其内容）')
    if not found:
        hint('没有发现未登记的手写站点')

def cmd_forget(a):
