ui_cert() {
    local name=$1 choice args=()
    echo '   1) 重新签发/立即续期   2) 模拟续期   3) 开启 HTTPS   4) 关闭 HTTPS   0) 返回'
    ask choice '请选择: ' || return 0
    case $choice in
        1|3) [[ ! -s $STATE/cloudflare.token ]] || args+=(--dns)
             ui_run cert issue "$name" "${args[@]}";;
        2) ui_run cert renew "$name" --dry-run;;
        4) confirm '关闭 HTTPS？' && ui_run cert off "$name";;
    esac
}
ui_cloud_toggle() {
    local name=$1 mode=on domain zone rows id type record content proxied payload old=() changed=() entry
    load_site "$name" || return 1
    [[ $TYPE != adopted ]] || { hint '请先升级为标准配置'; return 1; }
    [[ $(ui_cloud_state "${DOMAINS%%,*}") != 橙云 ]] || mode=off
    [[ $mode != on || -s $STATE/cloudflare-ips.txt ]] || ui_run cf update || return 1
    if [[ ! -s $STATE/cloudflare.token ]]; then
        hint "请在 Cloudflare 控制台 → DNS 把云朵改为 $([[ $mode == on ]] && echo 橙云 || echo 灰云)"
        confirm '只修改 nginx 的 Cloudflare 模式？' || return 0
        ui_run set "$name" cloudflare "$mode"
        return
    fi
    # 先收集所有记录，再修改。修改失败则尽力恢复已修改的 DNS。
    for domain in ${DOMAINS//,/ }; do
        zone=$(cf_zone "$domain") && rows=$(cf_records "$zone" "$domain") || return 1
        local found=0
        while IFS=$'\t' read -r id type record content proxied; do
            case $type in A|AAAA|CNAME) ;; *) continue;; esac
            found=1
            old+=("$zone $id $proxied")
        done <<< "$rows"
        ((found)) || { err "$domain 没有可切换的 DNS 记录"; return 1; }
    done
    local failed=0 flag=false
    [[ $mode != on ]] || flag=true
    for entry in "${old[@]}"; do
        read -r zone id proxied <<< "$entry"
        payload="{\"proxied\":$flag}"
        if cf_api PATCH "/zones/$zone/dns_records/$id" "$payload" >/dev/null; then changed+=("$entry"); else failed=1; break; fi
    done
    if ((failed==0)); then ui_run set "$name" cloudflare "$mode" || failed=1; fi
    if ((failed)); then
        for entry in "${changed[@]}"; do
            read -r zone id proxied <<< "$entry"
            flag=false; [[ $proxied != True ]] || flag=true
            cf_api PATCH "/zones/$zone/dns_records/$id" "{\"proxied\":$flag}" >/dev/null || err 'DNS 恢复失败，请检查 Cloudflare 控制台'
        done
        return 1
    fi
    rm -rf -- "$STATE/cache"
    ok "$name · $([[ $mode == on ]] && echo 橙云 || echo 灰云) · nginx Cloudflare $mode"
    [[ $mode != on ]] || hint 'Cloudflare SSL 模式请选择 Full (strict)'
}
ui_add() {
    local choice type domain name port backend directory https=on dns=未修改 cloud=灰云 args=() zone
    title '新建网站'
    echo '   1) EmbyHub   2) 其他服务   3) 静态网页'
    ask choice '类型 [1]: ' 1 || return 1
    case $choice in 1) type=emby;; 2) type=proxy;; 3) type=static;; *) return 1;; esac
    ask domain '域名: ' || return 1
    domain=${domain,,}; host_valid "$domain" || { err '域名无效'; return 1; }
    name=${domain%%.*}
    name_valid "$name" || { err '域名第一段不能作为网站名称，请用 CLI 指定名称'; return 1; }
    if [[ -e $STATE/sites/$name.env ]]; then
        local index=2
        while [[ -e $STATE/sites/$name-$index.env ]]; do ((index++)); done
        name=$name-$index
    fi
    ask port '端口 [443]: ' 443 || return 1
    if [[ $type == static ]]; then
        ask directory "网页目录 [/var/www/$name]: " "/var/www/$name" || return 1
        args+=(--root "$directory")
    else
        backend=127.0.0.1:10618; [[ $type == emby ]] || backend=127.0.0.1:8080
        ask backend "后端地址 [$backend]: " "$backend" || return 1
        args+=(--upstream "$backend")
    fi
    confirm_y '启用 HTTPS？' || { https=off; args+=(--no-tls); }
    # DNS 创建必须在证书签发前；先登记无 TLS，再申请证书。
    if [[ -s $STATE/cloudflare.token ]] && zone=$(cf_zone "$domain" 2>/dev/null); then
        [[ $https != on ]] || args+=(--dns)
        if confirm_y '把 DNS 指向本机公网 IP？'; then
            confirm '使用橙云？默认灰云' && cloud=橙云
            dns=已更新
        fi
    elif [[ $https == on ]]; then
        hint '请把 DNS 指向本机，并放行 80 端口（含云安全组）'
    fi
    if [[ $dns == 已更新 ]]; then
        ui_run add "$name" --type "$type" --domain "$domain" --port "$port" "${args[@]}" --no-tls || return 1
        local mode=off
        [[ $cloud != 橙云 ]] || mode=on
        if ! ui_run dns set "$name" --proxied "$mode"; then hint '网站已创建，DNS 更新失败；请修正 Token 后重试'; return 1; fi
        if [[ $cloud == 橙云 ]]; then ui_run cf update && ui_run set "$name" cloudflare on || return 1; fi
        [[ $https != on ]] || ui_run cert issue "$name" --dns || return 1
    else
        ui_run add "$name" --type "$type" --domain "$domain" --port "$port" "${args[@]}" || return 1
    fi
    load_site "$name" || return 1
    local scheme=http suffix=":$port"
    [[ $TLS != on ]] || scheme=https
    [[ $port != 443 || $scheme != https ]] || suffix=''
    title '网站已创建'
    hint "URL：$scheme://$domain$suffix"
    hint "证书：$(ui_cert_label) · DNS：$dns · Cloudflare：$(ui_cloud_state "$domain")"
    emby_hint
}
