# ---------- 原配置接管：解析器不执行 nginx 配置或元数据 ----------
adopt_engine() {
    python3 - "$ROOT" "$@" <<'PY'
import sys,os,re,glob,shlex,datetime,hashlib,shutil,tempfile,fcntl
root,action,*args=sys.argv[1:]; etc=root+'/etc/nginx'; state=root+'/etc/ngx'; back=root+'/var/backups/ngx/adopted'
def readmeta(path):
    try: return dict(line.rstrip('\n').split('=',1) for line in open(path) if '=' in line)
    except OSError: return {}
def safe(path):
    return bool(re.fullmatch(r'/[\w./-]+',path)) and '..' not in path.split('/')
def physical(path):
    if root and not path.startswith(root+'/'): return root+path if path.startswith('/') else etc+'/'+path
    return path if path.startswith('/') else etc+'/'+path
def directives(path,seen=None):
    seen=set() if seen is None else seen
    real=os.path.realpath(path)
    if real in seen: return []
    seen.add(real)
    try:
        text=open(path).read()
        lex=shlex.shlex(text,posix=True,punctuation_chars='{};'); lex.whitespace_split=True; lex.commenters='#'
        tokens=[p for t in lex for p in (list(t) if all(c in '{};' for c in t) else [t])]
    except (OSError,ValueError): return []
    result=[]; stack=[]; current=[]
    for t in tokens:
        if t=='{':
            stack.append(current[0] if current else ''); current=[]
        elif t=='}':
            if stack: stack.pop()
            current=[]
        elif t==';':
            if current:
                result.append((tuple(stack),current))
                if current[0]=='include' and len(current)>1:
                    for f in sorted(glob.glob(physical(current[1]))):
                        result.extend((tuple(stack)+scope,d) for scope,d in directives(f,seen))
            current=[]
        else: current.append(t)
    return result

def parse(file,links=''):
    actual=file if os.path.isfile(file) else file+'.disabled'
    rows=directives(actual); server=[d for scope,d in rows if 'server' in scope]
    if not server: return None
    def values(key): return list(dict.fromkeys(d[1] for d in server if d[0]==key and len(d)>1))
    domains=list(dict.fromkeys(v for d in server if d[0]=='server_name' for v in d[1:]))
    listens=[' '.join(d[1:]) for d in server if d[0]=='listen'] or ['80']
    ports=[]; tlsports=[]
    for d in listens:
        bits=d.split(); m=re.search(r'(?:^|:)(\d+)$',bits[0])
        if m:
            port=m[1]; ports.append(port)
            if 'ssl' in bits: tlsports.append(port)
    rawups=values('proxy_pass'); upstreams=[]
    for raw in rawups:
        if re.match(r'^https?://',raw):
            up=re.sub(r'^https?://','',raw)
            if up.startswith('unix:'): up=up.split(':/',1)[0].rstrip(':')
            else:
                up=up.split('/',1)[0]
                if ':' not in up: up+=':443' if raw.startswith('https:') else ':80'
            upstreams.append(up)
    certs=[physical(p) for p in values('ssl_certificate') if '$' not in p]
    certname=''
    if certs:
        m=re.fullmatch(re.escape(root)+r'/etc/letsencrypt/live/([A-Za-z0-9][A-Za-z0-9_.-]*)/[^/]+',certs[0])
        if m: certname=m[1]
    def logpaths(key):
        val=values(key)
        if not val:
            val=[d[1] for scope,d in directives(etc+'/nginx.conf') if 'server' not in scope and d[0]==key and len(d)>1]
        return ','.join(physical(v) for v in val if v!='off' and not v.startswith('syslog:') and '$' not in v)
    enabled=False
    if file.startswith(etc+'/conf.d/'): enabled=os.path.isfile(file) and file.endswith('.conf')
    else:
        enabled=any(os.path.lexists(l) for l in links.split(',') if l)
        if file.startswith(etc+'/sites-enabled/'): enabled=os.path.isfile(file)
    result=dict(TYPE='adopted',FILE=file,LINKS=links,DOMAINS=','.join(domains),LISTENS=','.join(listens),
                PORT=(tlsports or ports or ['80'])[0],UPSTREAM=upstreams[0] if upstreams else '',UPSTREAMS=','.join(upstreams),
                DOCROOT=(values('root') or [''])[0],TLS='on' if certs or tlsports else 'off',CERT_PATHS=','.join(certs),
                CERT_NAME=certname,ACCESS_LOGS=logpaths('access_log'),ERROR_LOGS=logpaths('error_log'),
                ENABLED='on' if enabled else 'off',CREATED=datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))
    # 元数据每项一行；不执行内容。无法安全表示的配置拒绝接管，原文件不动。
    if any('\n' in v or '\r' in v for v in result.values()): return None
    return result

def emit(data):
    for k,v in data.items(): print(k+'='+v)
def atomic(path,content):
    fd,tmp=tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd,'w') as f: f.write(content)
        os.replace(tmp,path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)
try:
    if action=='parse':
        data=parse(*args)
        if not data: raise ValueError('无法解析 server 配置：'+args[0])
        emit(data); sys.exit(0)
    if action!='scan': raise ValueError('未知接管操作')
    dry=bool(args and args[0]=='--dry-run')
    # dry-run 和没有新站点的扫描绝不创建目录、锁、备份或元数据。
    lock=None
    metas={os.path.basename(p)[:-4]:readmeta(p) for p in glob.glob(state+'/sites/*.env')}
    registered=set()
    for name,m in metas.items():
        for p in (m.get('FILE',''),m.get('ORIGIN_FILE',''),etc+'/sites-available/ngx-'+name+'.conf'):
            if p: registered.add(os.path.realpath(p))
    candidates={}
    for folder in ('sites-enabled','sites-available','conf.d'):
        for p in sorted(glob.glob(etc+'/'+folder+'/*')):
            if not os.path.isfile(p): continue
            if folder=='conf.d' and not p.endswith('.conf'): continue
            real=os.path.realpath(p)
            # 已替换的 Debian default 保持禁用，不再次接管。
            if os.path.basename(real)=='default' and os.path.lexists(etc+'/ngx-default.disabled'): continue
            if real in registered: continue
            if '# managed-by: ngx' in open(p).read(): continue
            if not safe(real) or not real.startswith(etc+'/'):
                print('  ! 路径不能安全接管：'+p,file=sys.stderr); continue
            entry=candidates.setdefault(real,[])
            if folder=='sites-enabled': entry.append(p)
    used=set(metas)
    for file,links in candidates.items():
        data=parse(file,','.join(links))
        if not data: continue
        stem=os.path.basename(file); stem=re.sub(r'\.conf$','',stem)
        stem=re.sub(r'[^\w-]','_',stem,flags=re.UNICODE).strip('_-')[:50] or 'site'
        if stem=='acme-80': stem='adopted-acme-80'
        name=stem; index=2
        while name in used:
            name=stem+'-'+str(index); index+=1
        used.add(name)
        if dry:
            print('  接管预览：'+name+' ← '+file); continue
        if lock is None:
            os.makedirs(root+'/run/lock',exist_ok=True)
            lock=open(root+'/run/lock/ngx.lock','a'); fcntl.flock(lock,fcntl.LOCK_EX)
        # 获锁后重新检查，避免两个自动扫描重复登记同一个原件。
        current=[readmeta(p) for p in glob.glob(state+'/sites/*.env')]
        if any(os.path.realpath(m.get('FILE',''))==file or os.path.realpath(m.get('ORIGIN_FILE',''))==file for m in current): continue
        while os.path.exists(state+'/sites/'+name+'.env'):
            name=stem+'-'+str(index); index+=1
        os.makedirs(state+'/sites',exist_ok=True); os.makedirs(back,mode=0o700,exist_ok=True)
        backup=back+'/'+name+'-'+hashlib.sha256(file.encode()).hexdigest()[:12]+'.conf'
        if not os.path.exists(backup):
            shutil.copy2(file,backup); os.chmod(backup,0o600)
        atomic(state+'/sites/'+name+'.env',''.join(k+'='+v+'\n' for k,v in data.items()))
        print('  ✔ 已接管 '+name+' ← '+file)
except (OSError,ValueError) as e:
    print('接管失败：'+str(e),file=sys.stderr); sys.exit(1)
PY
}
adopted_refresh() {
    if ! path_valid "$FILE" || [[ $FILE != "$ETC/"* ]]; then err '接管路径无效或位于 nginx 目录之外'; return 1; fi
    local data key value
    data=$(adopt_engine parse "$FILE" "$LINKS") || return 1
    while IFS='=' read -r key value; do
        case $key in TYPE|FILE|LINKS|DOMAINS|PORT|LISTENS|UPSTREAM|UPSTREAMS|DOCROOT|TLS|CERT_PATHS|CERT_NAME|ACCESS_LOGS|ERROR_LOGS|ENABLED|CREATED) printf -v "$key" '%s' "$value";; esac
    done <<< "$data"
}
site_file() {
    if [[ $TYPE == adopted ]]; then
        if [[ -f $FILE ]]; then printf '%s' "$FILE"; else printf '%s.disabled' "$FILE"; fi
    else printf '%s/sites-available/ngx-%s.conf' "$ETC" "$NAME"; fi
}
site_enabled() {
    if [[ $TYPE == adopted ]]; then [[ $ENABLED == on ]];
    else [[ -L $ETC/sites-enabled/ngx-$NAME.conf ]]; fi
}
cert_path() {
    if [[ $TYPE == adopted ]]; then printf '%s' "${CERT_PATHS%%,*}";
    else printf '%s/live/%s/fullchain.pem' "$LE" "$(cert_id)"; fi
}
adopted_save() {
    local key
    for key in TYPE FILE LINKS DOMAINS PORT LISTENS UPSTREAM UPSTREAMS DOCROOT TLS CERT_PATHS CERT_NAME ACCESS_LOGS ERROR_LOGS ENABLED CREATED CERT_METHOD; do
        printf '%s=%s\n' "$key" "${!key}"
    done > "$STATE/sites/$NAME.env"
}
adopted_toggle() {
    local mode=$1 link
    if [[ $FILE == "$ETC/conf.d/"* ]]; then
        if [[ $mode == disable && -e $FILE ]]; then mv -- "$FILE" "$FILE.disabled" || return 1;
        elif [[ $mode == enable && -e $FILE.disabled ]]; then mv -- "$FILE.disabled" "$FILE" || return 1; fi
    elif [[ $FILE == "$ETC/sites-enabled/"* && ! -L $FILE ]]; then
        # sites-enabled 中的实体配置需在显式停用时保存到 sites-available，防止 * 通配符继续加载。
        local saved=$ETC/sites-available/adopted-$NAME.conf
        [[ ! -e $saved ]] || { err "停用备份路径已存在：$saved"; return 1; }
        LINKS=$FILE
        mv -- "$FILE" "$saved" || return 1
        FILE=$saved
        [[ $mode != enable ]] || ln -s "$FILE" "$LINKS" || return 1
    else
        if [[ -z $LINKS ]]; then LINKS=$ETC/sites-enabled/$(basename "$FILE"); fi
        local links
        IFS=, read -r -a links <<< "$LINKS"
        for link in "${links[@]}"; do
            [[ $link == "$ETC/sites-enabled/"* ]] && path_valid "$link" || return 1
            if [[ $mode == disable ]]; then
                [[ ! -e $link && ! -L $link || -L $link ]] || { err "拒绝删除实体配置：$link"; return 1; }
                rm -f -- "$link" || return 1
            elif [[ ! -e $link && ! -L $link ]]; then ln -s "$FILE" "$link" || return 1;
            elif [[ $(readlink -f -- "$link") != "$(readlink -f -- "$FILE")" ]]; then err "启用路径已被占用：$link"; return 1; fi
        done
    fi
    ENABLED=off; [[ $mode != enable ]] || ENABLED=on
    adopted_save
}
adopted_change() {
    local command=$1; shift
    case $command in
        set) err "接管站点不支持 ngx set；请 ngx edit $NAME 或 ngx convert $NAME --type emby|proxy|static"; return 1;;
        rm) err "接管站点保留原文件，请 ngx disable $NAME；转换后可使用 ngx rm"; return 1;;
        edit|enable|disable) [[ $# == 0 ]] || return 1;;
        *) return 1;;
    esac
    begin || return 1
    case $command in
        edit) "${EDITOR:-vi}" "$(site_file)" && adopted_refresh && adopted_save || return 1;;
        enable|disable) adopted_toggle "$command" || return 1;;
    esac
    finish
}
adopted_issue() {
    [[ -n $CERT_NAME && $CERT_PATHS != *,* ]] || { err '无法关联唯一 certbot lineage；请先 ngx convert 并指定域名'; return 1; }
    domains_valid "$DOMAINS" || { err '接管域名含通配符或正则，HTTP-01 需要明确域名；请先转换'; return 1; }
    # 不向原配置注入 location；它必须已经把 HTTP-01 请求交给 ngx-acme webroot。
    if [[ $CERT_METHOD != dns && $DNS_REQUEST == 0 ]]; then
        hint "接管站点使用原证书 lineage $CERT_NAME 重新签发；请确保原站点 HTTP/TLS 均服务 $WEB/.well-known/acme-challenge/"
    fi
    begin && issue && adopted_save && finish
}
convert_site() {
    load_site "${1:-}" || return 1; shift
    [[ $TYPE == adopted ]] || { err '仅接管站点需要转换'; return 1; }
    local original original_file=$FILE old_name=$NAME old_links=$LINKS old_type=$TYPE candidate chosen='' arg
    original=$(site_file)
    # 多上游/多 TLS lineage 不能默选；要求用户指定覆盖项。
    local domain_override=0 upstream_override=0 port_override=0
    CLOUDFLARE=off CF_ONLY=off
    while (($#)); do
        arg=$1; shift
        case $arg in
            --type|--domain|--port|--upstream|--root|--email)
                (($#)) || return 1
                case $arg in --type) chosen=$1;; --domain) DOMAINS=${1,,}; domain_override=1;; --port) PORT=$1; port_override=1;; --upstream) UPSTREAM=$1; upstream_override=1;; --root) DOCROOT=$1;; --email) EMAIL=$1;; esac
                shift;;
            --no-tls) TLS=off; CERT_NAME='';; --cloudflare) CLOUDFLARE=on;; --cf-only) CLOUDFLARE=on CF_ONLY=on;;
            *) err "未知转换参数：$arg"; return 1;;
        esac
    done
    [[ -n $chosen ]] || { err '转换必须指定 --type'; return 1; }
    [[ $UPSTREAMS != *,* || $upstream_override == 1 || $chosen == static ]] || { err '原配置有多个上游，请用 --upstream 明确指定'; return 1; }
    [[ $CERT_PATHS != *,* || $domain_override == 1 ]] || { err '原配置有多个证书，请用 --domain 明确转换范围'; return 1; }
    if [[ $PORT == 80 && $port_override == 0 ]]; then err '80 为 ACME 保留，请用 --port 指定新端口'; return 1; fi
    TYPE=$chosen; DOCROOT=${DOCROOT:-/var/www/html}; UPSTREAM=${UPSTREAM:-127.0.0.1:18618}
    # NGX_ROOT 下解析出的 root 可能已带测试根。
    [[ -z $ROOT || $DOCROOT != "$ROOT/"* ]] || DOCROOT=${DOCROOT#"$ROOT"}
    ORIGIN_FILE=$original_file
    validate_site || return 1
    begin || return 1
    candidate=$TX/candidate.conf
    local generated=$ETC/sites-available/ngx-$NAME.conf
    [[ ! -e $generated ]] || { err '目标 ngx 配置已存在'; return 1; }
    generate || return 1
    mv "$generated" "$candidate" || return 1
    diff -u --label "$original" --label "ngx-$NAME.conf（候选）" "$original" "$candidate"
    local result=$?
    ((result<=1)) || return 1
    if ! ((YES)) && ! confirm '确认转换为以上配置并停用原站点？'; then
        # 尚未修改任何原配置，无需 reload。
        rm -rf -- "$TX"; TX=''; trap - EXIT INT TERM; return 1
    fi
    # 保存生成后的字段，停用原站点时仅临时切换类型。
    TYPE=$old_type FILE=$original_file LINKS=$old_links NAME=$old_name
    adopted_toggle disable || return 1
    ORIGIN_FILE=$FILE; TYPE=$chosen
    layout && cp "$candidate" "$generated" && save_site || return 1
    ln -s "$generated" "$ETC/sites-enabled/ngx-$NAME.conf" || return 1
    if [[ $TLS == on && ! -s $(cert_path) ]]; then
        generate off && apply && issue && generate on || return 1
    fi
    finish && cf_warnings && emby_hint
}

# API 响应仅解析，不打印服务器错误正文（可能包含敏感信息）。
cf_api() {
    local method=$1 endpoint=$2 payload=${3:-} token=${CF_TOKEN:-} response
    if [[ -z $token && -f $STATE/cloudflare.token && ! -L $STATE/cloudflare.token ]]; then
        IFS= read -r token < "$STATE/cloudflare.token"
    fi
    [[ $token =~ ^[a-zA-Z0-9_-]{8,256}$ ]] || { err '请先添加 Cloudflare Token'; return 1; }
    response=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
        curl --config - --proto '=https' -fsS --max-time 20 -X "$method" \
        -H 'Content-Type: application/json' ${payload:+--data-binary "$payload"} \
        "https://api.cloudflare.com/client/v4$endpoint" 2>/dev/null) || { err 'Cloudflare 请求失败；检查网络和 Token 权限'; return 1; }
    python3 -c 'import json,sys
try:
 d=json.load(sys.stdin)
 if d.get("success") is not True: raise ValueError()
 print(json.dumps(d))
except (ValueError,TypeError): sys.exit(1)' <<< "$response" || { err 'Token 无效或权限不足：需要 Zone.DNS Edit + Zone.Zone Read'; return 1; }
}
cf_rows() {
    python3 -c 'import json,sys
for r in json.load(sys.stdin)["result"]:
 print("\t".join(str(r.get(k,"")) for k in sys.argv[1:]))' "$@"
}
cf_zones() {
    local page=1 data pages
    while true; do
        data=$(cf_api GET "/zones?per_page=50&page=$page") || return 1
        cf_rows id name <<< "$data"
        pages=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("result_info",{}).get("total_pages",1))' <<< "$data")
        [[ $pages =~ ^[0-9]+$ ]] || return 1
        ((page<pages)) || break
        ((page++))
    done
}
cf_zone() {
    local rows
    rows=$(cf_zones) || return 1
    python3 - "$1" "$rows" <<'PY'
import sys
name=sys.argv[1].lower(); matches=[]
for row in sys.argv[2].splitlines():
 zone_id,zone=row.split('\t'); zone=zone.lower()
 if name==zone or name.endswith('.'+zone): matches.append((len(zone),zone_id))
if not matches: sys.exit(1)
print(max(matches)[1])
PY
}
cf_token_check() {
    local data zones id zone
    data=$(cf_api GET /user/tokens/verify) || return 1
    python3 -c 'import json,sys; sys.exit(json.load(sys.stdin)["result"].get("status")!="active")' <<< "$data" || { err 'Token 未启用'; return 1; }
    zones=$(cf_zones) || return 1
    [[ -n $zones ]] || { err 'Token 没有可管理的域名'; return 1; }
    while IFS=$'\t' read -r id zone; do
        cf_api GET "/zones/$id/dns_records?per_page=1" >/dev/null || return 1
    done <<< "$zones"
    hint '需要 Zone.DNS Edit + Zone.Zone Read，仅授权所需域名；不要使用 Global API Key'
    hint 'DNS 读取正常；编辑权限在写入时验证'
    printf '%s\n' "$zones" | cut -f2
}
cf_token() {
    [[ $# == 1 ]] || { err '用法：ngx cf token set|test|rm|zones'; return 1; }
    local token tmp
    case $1 in
        set)
            read -r -s -p '  Cloudflare Token: ' token || return 1
            echo
            CF_TOKEN=$token cf_token_check || return 1
            mkdir -p "$STATE" || return 1
            tmp=$(mktemp "$STATE/.token.XXXXXXXX") || return 1
            chmod 600 "$tmp"; chown 0:0 "$tmp"
            printf '%s\n' "$token" > "$tmp"
            mv -f -- "$tmp" "$STATE/cloudflare.token" || return 1
            rm -rf -- "$STATE/cache"
            ok "Token 已保存 · …${token: -4}" ;;
        test) cf_token_check && ok 'Token 检查通过';;
        rm) rm -f -- "$STATE/cloudflare.token"; rm -rf -- "$STATE/cache"; ok 'Token 已删除';;
        zones) cf_zones | cut -f2;;
        *) return 1;;
    esac
}
cf_records() {
    local zone=$1 domain=$2 page=1 data pages
    while true; do
        data=$(cf_api GET "/zones/$zone/dns_records?name=$domain&per_page=100&page=$page") || return 1
        cf_rows id type name content proxied <<< "$data"
        pages=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("result_info",{}).get("total_pages",1))' <<< "$data")
        [[ $pages =~ ^[0-9]+$ ]] || return 1
        ((page<pages)) || break
        ((page++))
    done
}
dns_command() {
    local action=${1:-} name=${2:-} proxied='' domain zone records id kind record address flag payload public4 public6
    [[ $action == list || $action == set ]] && (($#>=2)) || return 1
    shift 2
    if (($#)); then [[ $# == 2 && $1 == --proxied && ( $2 == on || $2 == off ) ]] || return 1; proxied=$2; fi
    load_site "$name" || return 1
    public4=''; public6=''
    if [[ $action == set ]]; then
        public4=$(curl -4 -fsS --max-time 8 https://api.ipify.org) || :
        public6=$(curl -6 -fsS --max-time 8 https://api6.ipify.org) || :
        python3 - "$public4" "$public6" <<'PY' || { err '无法获取公网 IP'; return 1; }
import sys,ipaddress
ips=[ipaddress.ip_address(v) for v in sys.argv[1:] if v]
if not ips: sys.exit(1)
if sys.argv[1] and ipaddress.ip_address(sys.argv[1]).version!=4: sys.exit(1)
if sys.argv[2] and ipaddress.ip_address(sys.argv[2]).version!=6: sys.exit(1)
PY
    fi
    for domain in ${DOMAINS//,/ }; do
        host_valid "$domain" || return 1
        zone=$(cf_zone "$domain") || { err "$domain 不在 Token 授权范围"; return 1; }
        records=$(cf_records "$zone" "$domain") || return 1
        if [[ $action == list ]]; then printf '%s\n' "$records"; continue; fi
        if awk -F '\t' '$2=="CNAME" {found=1} END {exit !found}' <<< "$records"; then err "$domain 已有 CNAME，请先在 Cloudflare 控制台处理"; return 1; fi
        for kind in A AAAA; do
            address=$public4; [[ $kind != AAAA ]] || address=$public6
            [[ -n $address ]] || continue
            record=$(awk -F '\t' -v t="$kind" '$2==t' <<< "$records")
            if [[ $(wc -l <<< "$record") -gt 1 ]]; then err "$domain 有多个 $kind 记录，请先在控制台处理"; return 1; fi
            id=${record%%$'\t'*}; flag=false
            [[ $proxied != on ]] || flag=true
            if [[ -z $proxied && $record == *$'\t'True ]]; then flag=true; fi
            payload=$(python3 - "$kind" "$domain" "$address" "$flag" <<'PY'
import json,sys
kind,name,address,flag=sys.argv[1:]
print(json.dumps(dict(type=kind,name=name,content=address,ttl=1,proxied=flag=='true')))
PY
)
            if [[ -n $id ]]; then cf_api PUT "/zones/$zone/dns_records/$id" "$payload" >/dev/null || return 1
            else cf_api POST "/zones/$zone/dns_records" "$payload" >/dev/null || return 1; fi
        done
        ok "$domain DNS 已更新"
    done
    [[ $action != set ]] || rm -rf -- "$STATE/cache"
}
# UI 缓存只存状态；CLI 的实时探测行为保持不变。
ui_cloud_state() {
    local domain=$1 cache=$STATE/cache/$1 now value zone rows
    host_valid "$domain" || { echo '—'; return; }
    now=$(date +%s)
    if [[ -f $cache && ! -L $cache ]] && ((now-$(stat -c %Y "$cache")<60)); then cat "$cache"; return; fi
    value='—'
    if [[ -s $STATE/cloudflare.token ]]; then
        if zone=$(cf_zone "$domain" 2>/dev/null) && rows=$(cf_records "$zone" "$domain" 2>/dev/null); then
            if awk -F '\t' '$2=="A" || $2=="AAAA" || $2=="CNAME" {n++; if($5=="True") p++} END {exit !(n && n==p)}' <<< "$rows"; then value=橙云
            elif awk -F '\t' '$2=="A" || $2=="AAAA" || $2=="CNAME" {found=1} END {exit !found}' <<< "$rows"; then value=灰云; fi
        fi
    else
        CF_PUBLIC4=$(curl -4 -fsS --max-time 8 https://api.ipify.org 2>/dev/null) || :
        CF_PUBLIC6=$(curl -6 -fsS --max-time 8 https://api6.ipify.org 2>/dev/null) || :
        value=$(cf_detect "$domain"); [[ $value != 其他 ]] || value='—'
    fi
    mkdir -p "$STATE/cache"
    printf '%s\n' "$value" > "$cache"
    printf '%s\n' "$value"
}
dns_credentials_clear() { [[ -z ${DNS_CREDENTIALS:-} ]] || rm -f -- "$DNS_CREDENTIALS"; DNS_CREDENTIALS=''; }
dns_hooks() {
    [[ $SELF =~ ^/[a-zA-Z0-9_./-]+$ ]] || { err 'DNS hook 的程序路径不能含特殊字符'; return 1; }
    DNS_AUTH_HOOK="NGX_ROOT=$ROOT $SELF _dns-auth"
    DNS_CLEANUP_HOOK="NGX_ROOT=$ROOT $SELF _dns-cleanup"
}
dns_auth_args() {
    [[ -s $STATE/cloudflare.token ]] || { err 'DNS-01 需要 Cloudflare Token'; return 1; }
    local domain token
    for domain in ${DOMAINS//,/ }; do cf_zone "$domain" >/dev/null || { err "$domain 未授权"; return 1; }; done
    dns_hooks || return 1
    DNS_AUTH=(--manual --preferred-challenges dns --manual-auth-hook "$DNS_AUTH_HOOK" --manual-cleanup-hook "$DNS_CLEANUP_HOOK")
    if certbot_cmd plugins 2>/dev/null | grep -q dns-cloudflare; then
        DNS_CREDENTIALS=$(mktemp "$TX/dns.XXXXXXXX.credentials") || return 1
        chmod 600 "$DNS_CREDENTIALS"
        IFS= read -r token < "$STATE/cloudflare.token"
        printf 'dns_cloudflare_api_token = %s\n' "$token" > "$DNS_CREDENTIALS"
        DNS_AUTH=(--dns-cloudflare --dns-cloudflare-credentials "$DNS_CREDENTIALS" --dns-cloudflare-propagation-seconds 60)
    fi
}
dns_renewal_config() {
    # 插件临时凭据删除后，续期统一用读取当前 Token 的持久 hook。
    python3 - "$LE/renewal/$(cert_id).conf" "$DNS_AUTH_HOOK" "$DNS_CLEANUP_HOOK" <<'PY'
import sys,re
path,auth,cleanup=sys.argv[1:]
text=open(path).read()
keys={'authenticator','manual_auth_hook','manual_cleanup_hook','pref_challs'}
lines=[l for l in text.splitlines() if l.split('=',1)[0].strip() not in keys and not re.match(r'\s*dns_cloudflare_',l)]
if '[renewalparams]' not in lines: lines.append('[renewalparams]')
index=lines.index('[renewalparams]')+1
# 插入到主 renewalparams，避免误写到尾部的 [[webroot_map]] 子节。
lines[index:index]=['authenticator = manual','pref_challs = dns-01,','manual_auth_hook = '+auth,'manual_cleanup_hook = '+cleanup]
open(path,'w').write('\n'.join(lines)+'\n')
PY
}
dns_hook() {
    local action=$1 domain=${CERTBOT_DOMAIN:-} zone payload data id rows type name content flag auth_id=${CERTBOT_AUTH_OUTPUT:-}
    auth_id=${auth_id//$'\n'/}; auth_id=${auth_id//$'\r'/}
    host_valid "$domain" && [[ ${CERTBOT_VALIDATION:-} =~ ^[a-zA-Z0-9_-]+$ ]] || return 1
    zone=$(cf_zone "$domain") || return 1
    name=_acme-challenge.$domain
    if [[ $action == _dns-auth ]]; then
        payload=$(python3 - "$name" "$CERTBOT_VALIDATION" <<'PY'
import json,sys
print(json.dumps(dict(type='TXT',name=sys.argv[1],content=sys.argv[2],ttl=60)))
PY
)
        data=$(cf_api POST "/zones/$zone/dns_records" "$payload") || return 1
        id=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["id"])' <<< "$data")
        # certbot 将 stdout 传给 cleanup；不含 Token。
        printf '%s\n' "$id"
        sleep 60
    else
        rows=$(cf_records "$zone" "$name") || return 1
        while IFS=$'\t' read -r id type name content flag; do
            if [[ $type == TXT && $content == "$CERTBOT_VALIDATION" && $id == "$auth_id" ]]; then
                cf_api DELETE "/zones/$zone/dns_records/$id" >/dev/null || return 1
            fi
        done <<< "$rows"
    fi
}

main "$@"
