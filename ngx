ui_doctor() {
    local findings line fix name
    title '一键体检'
    findings=$(ui_findings)
    [[ -n $findings ]] || { ok '一切正常'; return; }
    while IFS= read -r line; do
        fix='检查网站配置或运行环境'; name=${line%% *}
        case $line in
            *缺少续期*deploy*hook*) fix='补上续期加载 hook';;
            *证书*|*续期*) fix='重新签发证书';;
            *TCP/80*) fix='放行 80 端口，并检查云安全组';;
            *Cloudflare*|*cloudflare*|*橙云*) fix='同步 IP 段，检查 DNS 和 Full (strict)';;
            *后端地址*) fix='启动服务，检查后端地址和端口';;
            *default*) fix='运行 ngx install 初始化配置';;
            *未运行*) fix='检查 nginx 配置后重启';;
        esac
        hint "$line → $fix"
        case $line in
            *缺少续期*deploy*hook*) [[ -f $STATE/sites/$name.env ]] || continue
                confirm "是否修复 $name 的续期加载 hook？" && ui_run cert hook "$name";;
            *证书剩余*) [[ -f $STATE/sites/$name.env ]] || continue
                if confirm "现在修复 $name 的证书？"; then
                    local args=(); [[ $(site_field "$name" CERT_METHOD) != dns ]] || args+=(--dns)
                    ui_run cert issue "$name" "${args[@]}"
                fi;;
            *TCP/80*) if confirm '运行 fw 放行 80？'; then if service_cmd fw open 80 tcp nginx >/dev/null 2>&1; then ok '已放行 80'; else err '放行失败'; fi; fi;;
            *realip*|*Cloudflare*范围*) confirm '同步 Cloudflare IP 段？' && ui_run cf update;;
            *default*) confirm '初始化配置？' && ui_run install;;
            *未运行*) confirm '重启 nginx？' && ui_run restart;;
        esac
    done <<< "$findings"
}
