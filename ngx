')
    [[ -z $duplicates ]] || { warn "重复 server_name：$duplicates"; problems=1; }
    for file in "$STATE"/sites/*.env; do
        load_site "$(basename "$file" .env)" || { problems=1; continue; }
        cf_display
        cf_warnings
        if [[ $CLOUDFLARE == on && ! -s $ETC/conf.d/ngx-cloudflare-realip.conf ]]; then warn "$NAME 缺少 Cloudflare realip 配置"; problems=1; fi
        if [[ $TYPE == adopted ]]; then
            local upstream original_upstream=$UPSTREAM certificate
            for upstream in ${UPSTREAMS//,/ }; do
                UPSTREAM=$upstream
                if [[ $(reachable) == ✗ ]]; then warn "$NAME 接管上游不可达：$upstream"; problems=1; fi
            done
            UPSTREAM=$original_upstream
            for certificate in ${CERT_PATHS//,/ }; do
                if ! openssl x509 -checkend 1209600 -noout -in "$certificate" >/dev/null 2>&1; then
                    warn "$NAME 接管证书不足 14 天或无法读取：$certificate"; problems=1
                fi
            done
        fi
        if [[ $(reachable) == ✗ ]]; then warn "$NAME 上游不可达：$UPSTREAM"; problems=1; fi
        if [[ $TLS == on ]]; then
            days=$(cert_days)
            if [[ $days == '?' ]] || ((days<14)); then warn "$NAME 证书剩余 $days 天"; problems=1; fi
            if ! grep -Eq '^[[:space:]]*deploy_hook *= *([^#]*[;&][[:space:]]*)?systemctl reload nginx([[:space:]]*([;&]|$))' "$LE/renewal/$(cert_id).conf" 2>/dev/null; then
                warn "$NAME 缺少续期 deploy hook，请 ngx cert hook $NAME"; problems=1
            fi
        fi
    done
    for file in "$LE"/renewal/*.conf; do
        if grep -Eq '^[[:space:]]*authenticator[[:space:]]*=[[:space:]]*nginx[[:space:]]*$' "$file"; then
            warn "${file##*/} 使用 authenticator = nginx，插件会修改配置；建议 ngx cert issue <名称> 切换 webroot"
            problems=1
        fi
    done
    local listeners
    listeners=$(ss -H -lntp) || listeners=''
    for file in "$STATE"/sites/*.env; do
        load_site "$(basename "$file" .env)" || continue
        local ports=("$PORT") entries entry endpoint checked_port
        if [[ $TYPE == adopted ]]; then
            IFS=, read -r -a entries <<< "$LISTENS"
            for entry in "${entries[@]}"; do
                endpoint=${entry%% *}; checked_port=${endpoint##*:}
                if port_valid "$checked_port"; then ports+=("$checked_port"); fi
            done
        fi
        for checked_port in "${ports[@]}"; do
            if awk -v p="$checked_port" '$4 ~ (":" p "$") && $0 !~ /"nginx"/ {found=1} END {exit !found}' <<< "$listeners"; then
                warn "$NAME 端口 $checked_port 有非 nginx/未知进程监听冲突"; problems=1
            fi
        done
    done
    ((problems==0)) && ok '未发现上述常见问题'
    return "$problems"
}
install_ngx() {
    if ! command -v nginx >/dev/null || ! command -v certbot >/dev/null; then
