# ---------- 旧版迁移 ----------
def extract_extra_locations(text):
    """从旧版生成的配置里取出手工追加的 location 块（不含 location /），连同紧邻的注释。"""
    lines, out, i, depth = text.splitlines(), [], 0, 0
    first_server_done = False
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if depth == 1 and not first_server_done and re.match(r'location\s', stripped) and not re.match(r'location\s+/\s*\{', stripped) and 'acme-challenge' not in stripped:
            start = i
            while start > 0 and lines[start - 1].strip().startswith('#') and 'ngx' not in lines[start - 1]:
                start -= 1
            block, d = [], 0
            for j in range(i, len(lines)):
                block.append(lines[j])
                d += lines[j].count('{') - lines[j].count('}')
                if d <= 0:
                    break
            out.append('\n'.join(l[4:] if l.startswith('    ') else l for l in lines[start:i] + block))
            i = j + 1
            continue
        depth += line.count('{') - line.count('}')
        if depth == 0 and stripped == '}':
            first_server_done = True
        i += 1
    return out

def migrate_legacy():
    envs = sorted(glob.glob(SITES + '/*.env'))
    if not envs or not os.access(STATE, os.W_OK):
        return
    title('升级 ngx 数据格式')
    with Tx() as tx:
        for env in envs:
            name = os.path.basename(env)[:-4]
            meta = dict(l.split('=', 1) for l in read(env).splitlines() if '=' in l)
            if meta.get('TYPE') == 'adopted':
                file = meta.get('FILE', '')
                site = dict(type='external', file=file, links=[l for l in meta.get('LINKS', '').split(',') if l],
                            domains=[d for d in meta.get('DOMAINS', '').split(',') if d],
                            cert=meta.get('CERT_PATHS', '').split(',')[0],
                            access_logs=[l for l in meta.get('ACCESS_LOGS', '').split(',') if l],
                            error_logs=[l for l in meta.get('ERROR_LOGS', '').split(',') if l], name=name)
            else:
                old_type = meta.get('TYPE', 'proxy')
                site = dict(DEFAULTS, name=name, type='static' if old_type == 'static' else 'proxy',
                            domains=[d for d in meta.get('DOMAINS', '').split(',') if d],
                            port=int(meta.get('PORT', '443') or 443), tls=meta.get('TLS') == 'on',
                            cert_name=meta.get('CERT_NAME', ''), cert_method=meta.get('CERT_METHOD', 'auto') or 'auto',
                            cloudflare=meta.get('CLOUDFLARE') == 'on', cf_only=meta.get('CF_ONLY') == 'on',
                            headers=old_type != 'emby', created=meta.get('CREATED', ''))
                site['routes'], site['allow'] = [], []
                if site['type'] == 'static':
                    site['root'] = meta.get('DOCROOT', '/var/www/html')
                else:
                    site['upstream'] = parse_upstream(meta.get('UPSTREAM', ''))
                extras = extract_extra_locations(read(conf_path(name)))
                custom = f'{CUSTOM}/{name}.conf'
                if extras and not os.path.exists(custom):
                    write(custom, f'# 从旧版配置中保留的手工片段\n' + '\n'.join(extras) + '\n')
                    ok(f'{name}：手工添加的 {len(extras)} 个 location 已保留到 {custom}')
            save(site)
            os.makedirs(STATE + '/legacy', exist_ok=True)
            os.replace(env, f'{STATE}/legacy/{name}.env')
        layout()
        for s in all_sites():
            if s['type'] != 'external':
                generate(s)
        tx.commit()

