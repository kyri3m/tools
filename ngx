def resolve_dns_target(key):
    """网站名 → 其第一个域名；其他按 DNS 名称处理。"""
    if name_valid(key) and os.path.isfile(site_path(key)):
        return load(key)['domains'][0].lstrip('*.')
    return key.lower().rstrip('.')

def record_content(r):
    if r['type'] == 'MX':
        return f'{r.get("priority", 0)} {r["content"]}'
    if r.get('data') and r['type'] in ('SRV', 'CAA'):
        d = r['data']
        keys = ('priority', 'weight', 'port', 'target') if r['type'] == 'SRV' else ('flags', 'tag', 'value')
        return ' '.join(str(d.get(k, '')) for k in keys)
    return r.get('content', '')

def cmd_dns(a):
    cf = CF()
    if a.action == 'ls':
        if a.name:
            name = resolve_dns_target(a.name)
            targets = [cf.zone_for(name)]
        else:
            name, targets = None, cf.zones()
        for zid, zone in targets:
            recs = cf.records(zid)
            if name and name != zone:
                recs = [r for r in recs if r['name'] == name or r['name'].endswith('.' + name)]
            title(f'{zone}（{len(recs)} 条）')
            sites = {d: s['name'] for s in all_sites() for d in s.get('domains', [])}
            rows = []
            for r in sorted(recs, key=lambda r: (r['name'].count('.'), r['name'], r['type'])):
                short = '@' if r['name'] == zone else r['name'][:-len(zone) - 1]
                cloud = ('橙云' if r.get('proxied') else '灰云') if r['type'] in ('A', 'AAAA', 'CNAME') else ''
                content = ''.join(c if c.isprintable() else ' ' for c in record_content(r))
                content = content if width(content) <= 48 else content[:45] + '…'
                rows.append([r['type'], short, content, cloud, sites.get(r['name'], '')])
            table(['类型', '名称', '内容', '代理', '网站'], rows)
    elif a.action == 'point':
        site = None
        try:
            site = find_site(a.name)
        except Fail:
            pass
        domains = site['domains'] if site else [a.name.lower()]
        proxied = parse_bool(a.proxied) if a.proxied else None
        for d in domains:
            if not d.startswith('*.'):
                ensure_dns(d, proxied=proxied, cf=cf)
    elif a.action == 'add':
        name = a.name.lower().rstrip('.')
        zid, zone = cf.zone_for(name)
        kind = a.type.upper()
        body = dict(type=kind, name=name, ttl=a.ttl)
        if kind in ('A', 'AAAA'):
            ip = ipaddress.ip_address(a.content)
            if ip.version != (4 if kind == 'A' else 6):
                raise Fail('IP 类型和记录类型不匹配')
            body['content'] = str(ip)
        elif kind in ('CNAME', 'TXT', 'NS'):
            body['content'] = a.content
        elif kind == 'MX':
            body.update(content=a.content, priority=a.priority if a.priority is not None else 10)
        else:
            raise Fail('ngx dns add 支持 A/AAAA/CNAME/TXT/MX/NS；其他类型请用 Cloudflare 控制台')
        if kind in ('A', 'AAAA', 'CNAME'):
            body['proxied'] = parse_bool(a.proxied) if a.proxied else False
        cf.req('POST', f'/zones/{zid}/dns_records', body)
        ok(f'已添加 {kind} {name} → {body["content"]}')
        clear_cache()
    elif a.action == 'rm':
        name = a.name.lower().rstrip('.')
        zid, zone = cf.zone_for(name)
        kind = (a.type or '').upper()
        recs = [r for r in cf.records(zid, name) if not kind or r['type'] == kind]
        if a.id:
            recs = [r for r in recs if r['id'] == a.id]
        if not recs:
            raise Fail('没有匹配的记录')
        if len(recs) > 1 and not a.all:
            for r in recs:
                hint(f'{r["type"]} {record_content(r)}  --id {r["id"]}')
            raise Fail('匹配到多条记录：加 --id 指定一条，或 --all 全部删除')
        owner = domain_owner(name)
        if owner:
            warn(f'{name} 正被网站 {owner} 使用，删除后网站将无法访问')
        if not confirm(f'删除 {len(recs)} 条 {kind or ""} {name} 记录？', default=False):
            raise Fail('已取消')
        for r in recs:
            cf.req('DELETE', f'/zones/{zid}/dns_records/{r["id"]}')
            ok(f'已删除 {r["type"]} {name} {record_content(r)}')
        clear_cache()

