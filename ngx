    printf '%s\n' "$output" | ui_words | sed -n '/^  [✔!✘]/p; /^  .*需要/p; /^  .*请/p'
    if ((result)); then err '操作失败，修改已尝试回滚；请按 d 体检'; else ok '完成'; fi
