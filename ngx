pause() { local _; read -r -s -p "  ${D}按回车返回…${N}" _ || true; echo; }
confirm_y() { local a; read -r -p "  $1 [Y/n] " a || return 1; [[ -z $a || $a == y || $a == Y ]]; }
site_names() { local f; for f in "$STATE"/sites/*.env; do [[ -e $f ]] || continue; f=${f##*/}; printf '%s\n' "${f%.env}"; done; }
site_field() { sed -n "s/^$2=//p" "$STATE/sites/$1.env" 2>/dev/null | head -1; }
type_label() { case $1 in emby) echo 'EmbyHub';; proxy) echo '反向代理';; static) echo '静态网站';; adopted) echo '接管';; *) echo "$1";; esac; }

# pick_site 变量名 [提示]：列出站点，按编号选择
pick_site() {
    local -a names; local i n mark c
    mapfile -t names < <(site_names)
    ((${#names[@]})) || { warn '还没有站点，先用「2) 添加站点」'; return 1; }
    echo
    for i in "${!names[@]}"; do
        n=${names[i]}
        if (load_site "$n" >/dev/null 2>&1 && site_enabled >/dev/null 2>&1); then mark="${G}●${N}"; else mark="${D}○${N}"; fi
        printf '   %s%2d%s) %s %s %s %s\n' "$BD" $((i + 1)) "$N" "$mark" "$(pad "$n" 14)" "$(pad "$(site_field "$n" DOMAINS)" 28)" "${D}$(type_label "$(site_field "$n" TYPE)")${N}"
    done
    hint '● 已启用  ○ 已停用'
    ask c "${2:-选择站点编号}: " || return 1
    if ! [[ $c =~ ^[0-9]+$ ]] || ((c < 1 || c > ${#names[@]})); then err '无效编号'; return 1; fi
    printf -v "$1" '%s' "${names[c - 1]}"
}

