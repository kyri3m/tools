# ---------- 输出 ----------
_color = sys.stdout.isatty() and os.environ.get('NO_COLOR') is None
def _c(code): return (lambda s: f'\033[{code}m{s}\033[0m') if _color else (lambda s: str(s))
red, green, yellow, cyan, dim, bold = _c(31), _c(32), _c(33), _c(36), _c(2), _c(1)

def ok(msg): print(f'  {green("✔")} {msg}')
def warn(msg): print(f'  {yellow("!")} {msg}')
def err(msg): print(f'  {red("✘")} {msg}', file=sys.stderr)
def hint(msg): print(f'  {dim(msg)}')
def title(msg): print(f'\n{bold(cyan("■ " + msg))}')

class Fail(Exception):
    pass

_ansi = re.compile(r'\x1b\[[0-9;]*m')
def width(s):
    s = _ansi.sub('', str(s))
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in 'WF' else 1 for c in s)

def pad(s, w):
    return str(s) + ' ' * max(0, w - width(s))

def table(headers, rows, indent='  '):
    cols = len(headers)
    widths = [max([width(headers[i])] + [width(r[i]) for r in rows]) for i in range(cols)]
    fit = lambda row: '  '.join(str(row[i]) if i == cols - 1 else pad(row[i], widths[i]) for i in range(cols))
    print(indent + dim(fit(headers)))
    for r in rows:
        print(indent + fit(r))

def ask(prompt, default=''):
    try:
        value = input(f'  {prompt}{f" [{default}]" if default else ""}: ').strip()
    except EOFError:
        raise Fail('已取消')
    return value or default

def confirm(prompt, default=False):
    if YES:
        return True
    if not sys.stdin.isatty():
        return default
    try:
        value = input(f'  {prompt} {"[Y/n]" if default else "[y/N]"} ').strip().lower()
    except EOFError:
        return False
    return default if not value else value in ('y', 'yes')

# ---------- 系统命令 ----------
def run(cmd, check=True, capture=True, input=None, env=None):
    try:
        p = subprocess.run(cmd, input=input, text=True, env=env,
                           stdout=subprocess.PIPE if capture else None,
                           stderr=subprocess.STDOUT if capture else None)
    except FileNotFoundError:
        if check:
            raise Fail(f'找不到命令：{cmd[0]}')
        return subprocess.CompletedProcess(cmd, 127, '')
    if check and p.returncode:
        out = (p.stdout or '').strip()
        raise Fail(f'{" ".join(cmd[:3])} 失败' + (f'：\n{out}' if out else ''))
    return p

def sys_cmd(cmd, check=True):
    # 测试根下不触碰真实服务。
    if ROOT:
        return subprocess.CompletedProcess(cmd, 0, '')
    return run(cmd, check=check)

def systemctl_active(unit):
    if ROOT:
        return True
    return run(['systemctl', 'is-active', '--quiet', unit], check=False).returncode == 0

def write(path, content, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.ngx.')
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def read(path, default=''):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default

def symlink(target, link):
    if os.path.lexists(link):
        os.unlink(link)
    os.symlink(target, link)

def config_get(key, default=''):
    for line in read(CONFIG).splitlines():
        k, _, v = line.partition('=')
        if k == key:
            return v
    return default

def config_set(key, value):
    lines = [l for l in read(CONFIG).splitlines() if l.partition('=')[0] != key]
    if value:
        lines.append(f'{key}={value}')
    write(CONFIG, '\n'.join(lines) + '\n')

# ---------- 校验 ----------
NAME_RE = re.compile(r'[^\W_][\w-]{0,63}')
LABEL_RE = re.compile(r'[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?')

def name_valid(name):
    return bool(NAME_RE.fullmatch(name)) and name != 'acme-80'

def host_valid(host, wildcard=False):
    host = host.lower()
    if wildcard and host.startswith('*.'):
        host = host[2:]
    labels = host.split('.')
    return len(host) <= 253 and len(labels) >= 2 and all(LABEL_RE.fullmatch(l) for l in labels)

def parse_domains(value):
    domains = list(dict.fromkeys(d.strip().lower().rstrip('.') for d in value.split(',') if d.strip()))
    if not domains:
        raise Fail('至少需要一个域名')
    for d in domains:
        if not host_valid(d, wildcard=True):
            raise Fail(f'域名无效：{d}')
    return domains

def parse_port(value):
    if not re.fullmatch(r'[1-9][0-9]{0,4}', str(value)) or int(value) > 65535:
        raise Fail(f'端口无效：{value}')
    return int(value)

UPSTREAM_PATH = re.compile(r'(/[A-Za-z0-9._~%/@:+-]*)?')
def parse_upstream(value):
    """3000 / host:port / [v6]:port / http(s)://host:port/path / unix:/path → 规范化后端地址。"""
    v = value.strip()
    if re.fullmatch(r'[0-9]+', v):
        return f'http://127.0.0.1:{parse_port(v)}'
    if v.startswith('unix:'):
        path = v[5:]
        if not re.fullmatch(r'/[\w./-]+', path) or '..' in path.split('/'):
            raise Fail(f'socket 路径无效：{path}')
        return 'unix:' + path
    scheme = 'http'
    m = re.match(r'(https?)://', v)
    if m:
        scheme, v = m[1], v[m.end():]
    hostport, slash, path = v.partition('/')
    path = slash + path
    if not UPSTREAM_PATH.fullmatch(path):
        raise Fail(f'后端路径含不支持的字符：{path}')
    m = re.fullmatch(r'\[([0-9a-fA-F:.]+)\](?::([0-9]+))?', hostport) or re.fullmatch(r'([^:\[\]]+)(?::([0-9]+))?', hostport)
    if not m:
        raise Fail(f'后端地址无效：{value}')
    host, port = m[1], m[2]
    try:
        ip = ipaddress.ip_address(host)
        host_text = f'[{ip}]' if ip.version == 6 else str(ip)
    except ValueError:
        if host != 'localhost' and not host_valid(host) and not LABEL_RE.fullmatch(host.lower()):
            raise Fail(f'后端主机无效：{host}')
        host_text = host.lower()
    port = parse_port(port) if port else (443 if scheme == 'https' else 80)
    return f'{scheme}://{host_text}:{port}{path.rstrip("/") if path != "/" else ""}'

def upstream_addr(upstream):
    """返回 (host, port) 或 ('unix', path)，用于探测。"""
    if upstream.startswith('unix:'):
        return 'unix', upstream[5:]
    hostport = upstream.split('://', 1)[1].split('/', 1)[0]
    host, _, port = hostport.rpartition(':')
    return host.strip('[]'), int(port)

def short_upstream(upstream):
    return re.sub(r'^http://', '', upstream).replace('127.0.0.1:', ':') if upstream else ''

def parse_size(value):
    if not re.fullmatch(r'[0-9]{1,6}[kKmMgG]?', value):
        raise Fail(f'大小无效：{value}（例如 100m、1g、0 表示不限）')
    return value.lower()

def parse_bool(value):
    v = str(value).lower()
    if v in ('on', 'yes', 'true', '1', '开'):
        return True
    if v in ('off', 'no', 'false', '0', '关'):
        return False
    raise Fail(f'应为 on 或 off：{value}')

def parse_route_path(value):
    exact = value.startswith('=')
    path = value[1:] if exact else value
    if not re.fullmatch(r'/[A-Za-z0-9._~%/@+-]*', path):
        raise Fail(f'路径无效：{value}（以 / 开头；精确匹配用 =/path）')
    return ('=' if exact else '') + path

# ---------- 站点 ----------
DEFAULTS = dict(type='proxy', domains=[], port=443, upstream='', root='', tls=True, cert_name='',
                cert_method='auto', cloudflare=False, cf_only=False, headers=True, routes=[],
                body='100m', timeout=3600, buffering=False, auth=False, allow=[], created='')

def site_path(name):
    return f'{SITES}/{name}.json'

def conf_path(name):
    return f'{ETC}/sites-available/ngx-{name}.conf'

def link_path(name):
    return f'{ETC}/sites-enabled/ngx-{name}.conf'

def load(name):
    if not name_valid(name or ''):
        raise Fail(f'网站名称无效：{name}')
    path = site_path(name)
    if not os.path.isfile(path) or os.path.islink(path):
        raise Fail(f'没有这个网站：{name}（ngx ls 查看全部）')
    try:
        data = json.loads(read(path))
    except ValueError:
        raise Fail(f'元数据损坏：{path}')
    site = dict(DEFAULTS, **data) if data.get('type') != 'external' else data
    site['name'] = name
    return site

def save(site):
    data = {k: v for k, v in site.items() if k != 'name'}
    write(site_path(site['name']), json.dumps(data, ensure_ascii=False, indent=2) + '\n')

def site_names():
    return sorted(os.path.basename(p)[:-5] for p in glob.glob(SITES + '/*.json'))

def all_sites():
    sites = []
    for n in site_names():
        try:
            sites.append(load(n))
        except Fail as e:
            warn(str(e))
    return sites

def find_site(key):
    """按名称或域名查找网站。"""
    if name_valid(key) and os.path.isfile(site_path(key)):
        return load(key)
    for s in all_sites():
        if key.lower() in s.get('domains', []):
            return s
    raise Fail(f'没有这个网站：{key}（ngx ls 查看全部）')

def enabled(site):
    if site['type'] == 'external':
        return any(os.path.lexists(l) for l in site.get('links', [])) or site['file'].startswith(ETC + '/conf.d/') and os.path.isfile(site['file'])
    return os.path.islink(link_path(site['name']))

def cert_name(site):
    if site.get('cert_name'):
        return site['cert_name']
    n = site['name']
    return 'ngx-' + (n if re.fullmatch(r'[A-Za-z0-9_-]+', n) else hashlib.sha256(n.encode()).hexdigest()[:24])

def cert_files(site):
    if site['type'] == 'external':
        return site.get('cert', ''), ''
    d = f'{LE}/live/{cert_name(site)}'
    return d + '/fullchain.pem', d + '/privkey.pem'

def cert_info(path):
    """返回 (剩余天数, 证书域名集合)；读不到返回 (None, set())。"""
    try:
        info = ssl._ssl._test_decode_cert(path)
    except Exception:
        return None, set()
    days = int((ssl.cert_time_to_seconds(info['notAfter']) - time.time()) // 86400)
    return days, {v.lower() for k, v in info.get('subjectAltName', ()) if k == 'DNS'}

def cert_ready(site):
    full, key = cert_files(site)
    return os.path.isfile(full) and os.path.isfile(key)

def needs_cert(site):
    if not site['tls']:
        return False
    days, names = cert_info(cert_files(site)[0])
    return days is None or days < 1 or not set(site['domains']) <= names

# ---------- nginx 配置生成 ----------
def layout():
    for d in ('sites-available', 'sites-enabled', 'snippets', 'conf.d'):
        os.makedirs(f'{ETC}/{d}', exist_ok=True)
    for d in (SITES, CUSTOM, f'{WEB}/.well-known/acme-challenge', LOG):
        os.makedirs(d, exist_ok=True)
    os.makedirs(HTPASSWD, mode=0o750, exist_ok=True)
    snippets = {
        'ngx-ssl.conf': f'''{MARK}
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:ngx_ssl:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
add_header Strict-Transport-Security "max-age=15768000" always;
''',
        'ngx-security.conf': f'''{MARK}
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header X-Frame-Options SAMEORIGIN always;
''',
        # 超时、上传大小、缓冲按网站写在 server 级；这里只放所有反代通用的头。
        'ngx-proxy.conf': f'''{MARK}
proxy_http_version 1.1;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Port $server_port;
proxy_redirect off;
gzip on;
gzip_proxied any;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
''',
        'ngx-acme.conf': f'''{MARK}
location ^~ /.well-known/acme-challenge/ {{
    allow all;
    auth_basic off;
    root {WEB};
    default_type text/plain;
    try_files $uri =404;
}}
''',
    }
    for name, content in snippets.items():
        write(f'{ETC}/snippets/{name}', content)
    write(f'{ETC}/conf.d/ngx-http.conf', f'''{MARK}
# 非 WebSocket 请求发空 Connection 头，配合 upstream keepalive 复用到后端的连接。
map $http_upgrade $connection_upgrade {{
    default upgrade;
    '' '';
}}
log_format ngx '$remote_addr - $remote_user [$time_local] "$request" '
               '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
               '$request_time $upstream_response_time $upstream_status';
''')
    # 没有 Cloudflare 配置时也要定义 $ngx_cf_peer，cf-only 网站才能通过 nginx -t。
    if not os.path.exists(f'{ETC}/conf.d/ngx-cloudflare-realip.conf'):
        write(f'{ETC}/conf.d/ngx-cloudflare-realip.conf', f'{MARK}\n# 运行 ngx cf update 后写入 Cloudflare 地址段\ngeo $ngx_cf_peer {{\n    default 0;\n}}\n')
    default = f'{ETC}/sites-enabled/default'
    if os.path.lexists(default):
        os.replace(default, f'{ETC}/ngx-default.disabled')
        warn('已停用发行版自带的 default 站点（备份为 /etc/nginx/ngx-default.disabled）')
    write(f'{ETC}/sites-available/ngx-acme-80.conf', f'''{MARK}
# 80 端口兜底：为所有域名提供 ACME 验证，其余请求 404。
server {{
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log {LOG}/ngx-acme-80.access.log ngx;
    include {ETC}/snippets/ngx-acme.conf;
    location / {{ return 404; }}
}}
# 443 兜底：未知域名或直连 IP 直接拒绝 TLS 握手，不暴露任何网站的证书。
server {{
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}}
''')
    symlink(f'{ETC}/sites-available/ngx-acme-80.conf', f'{ETC}/sites-enabled/ngx-acme-80.conf')

def proxy_target(upstream):
    if upstream.startswith('unix:'):
        return f'http://unix:{ROOT}{upstream[5:]}:'
    return upstream

def render(site):
    name, tls = site['name'], site['tls']
    ready = tls and cert_ready(site)
    scheme = 'https' if tls else 'http'
    names = ' '.join(site['domains'])
    xff = '$remote_addr' if site['cloudflare'] else '$proxy_add_x_forwarded_for'
    gate = ['if ($ngx_cf_peer = 0) { return 403; }'] if site['cf_only'] else []
    port = site['port']

    pools = {}  # 后端地址 → upstream 名；http/unix 后端走 upstream 以便 keepalive

    def pool_target(upstream):
        if upstream.startswith('https://'):
            return proxy_target(upstream)
        if upstream.startswith('unix:'):
            server, path = f'unix:{ROOT}{upstream[5:]}', ''
        else:
            server, slash, path = upstream[7:].partition('/')
            path = slash + path
        pool = pools.setdefault(server, f'ngx_{name}_{len(pools)}')
        return f'http://{pool}{path}'

    def proxy_block(upstream):
        lines = gate + [f'include {ETC}/snippets/ngx-proxy.conf;',
                        f'proxy_set_header X-Forwarded-For {xff};',
                        f'proxy_set_header X-Forwarded-Proto {scheme};']
        if upstream.startswith('https://'):
            lines.append('proxy_ssl_server_name on;')
        return lines + [f'proxy_pass {pool_target(upstream)};']

    def location(spec, body):
        head = f'= {spec[1:]}' if spec.startswith('=') else spec
        return [f'    location {head} {{'] + [f'        {l}' for l in body] + ['    }']

    out = [MARK, f'# 由 ngx 生成，请勿手改：用 ngx set/route 修改；自定义片段写在 {CUSTOM}/{name}.conf', 'server {']
    ssl_flag = ' ssl' if tls else ''
    out += [f'    listen {port}{ssl_flag};', f'    listen [::]:{port}{ssl_flag};', f'    server_name {names};',
            f'    access_log {LOG}/ngx-{name}.access.log ngx buffer=32k flush=5s;', f'    error_log {LOG}/ngx-{name}.error.log;']
    if site['headers']:
        out.append(f'    include {ETC}/snippets/ngx-security.conf;')
    out.append(f'    include {ETC}/snippets/ngx-acme.conf;')
    if ready:
        full, key = cert_files(site)
        out += ['    http2 on;', f'    ssl_certificate {full};', f'    ssl_certificate_key {key};', f'    include {ETC}/snippets/ngx-ssl.conf;']
    elif tls:
        out.append('    # 证书尚未签发：先拒绝 TLS 握手，签发后自动重新生成。')
        out.append('    ssl_reject_handshake on;')
    out += [f'    client_max_body_size {site["body"]};', f'    proxy_read_timeout {site["timeout"]}s;',
            f'    proxy_send_timeout {site["timeout"]}s;', f'    send_timeout {site["timeout"]}s;']
    buffering = 'on' if site['buffering'] else 'off'
    out += [f'    proxy_buffering {buffering};', f'    proxy_request_buffering {buffering};']
    for cidr in site['allow']:
        out.append(f'    allow {cidr};')
    if site['allow']:
        out.append('    deny all;')
    if site['auth']:
        out += [f'    auth_basic "{name}";', f'    auth_basic_user_file {HTPASSWD}/{name};']
    custom = f'{CUSTOM}/{name}.conf'
    if os.path.isfile(custom):
        out.append(f'    include {custom};')
    for r in site['routes']:
        out += location(r['path'], proxy_block(r['upstream']))
    if site['type'] == 'static':
        out.append(f'    root {ROOT}{site["root"]};')
        out.append('    index index.html index.htm;')
        out += location('/', gate + ['try_files $uri $uri/ =404;'])
    else:
        out += location('/', proxy_block(site['upstream']))
    out.append('}')
    if port != 80:
        target = f'{scheme}://$host' + ('' if (tls and port == 443) or (not tls and port == 80) else f':{port}') + '$request_uri'
        out += ['server {', '    listen 80;', '    listen [::]:80;', f'    server_name {names};',
                f'    include {ETC}/snippets/ngx-acme.conf;', f'    location / {{ return 301 {target}; }}', '}']
    head = []
    for server, pool in pools.items():
        head += [f'upstream {pool} {{', f'    server {server};', '    keepalive 32;', '}']
    if head:
        out[2:2] = head
    return '\n'.join(out) + '\n'

def validate(site):
    if site['type'] not in ('proxy', 'static'):
        raise Fail('类型只能是 proxy 或 static')
    parse_domains(','.join(site['domains']))
    parse_port(site['port'])
    if site['tls'] and site['port'] == 80:
        raise Fail('80 端口用于证书验证和跳转，HTTPS 网站请用 443 等端口')
    if site['type'] == 'proxy':
        parse_upstream(site['upstream'])
    elif not re.fullmatch(r'/[\w./-]*', site['root'] or ''):
        raise Fail('静态网站目录必须是绝对路径')
    if site['cf_only'] and not site['cloudflare']:
        raise Fail('cf-only 需要先开启 Cloudflare 模式（ngx cf proxied <网站> on）')

def generate(site):
    validate(site)
    write(conf_path(site['name']), render(site))

# ---------- 事务 ----------
def managed_paths():
    paths = set()
    for d in ('sites-available', 'sites-enabled', 'snippets', 'conf.d'):
        paths.update(glob.glob(f'{ETC}/{d}/ngx-*'))
    for p in (f'{ETC}/ngx-default.disabled', f'{ETC}/sites-enabled/default',
              f'{SYSTEMD}/ngx-cf-update.service', f'{SYSTEMD}/ngx-cf-update.timer'):
        if os.path.lexists(p):
            paths.add(p)
    for base, dirs, files in os.walk(STATE):
        if base.startswith(CACHE):
            continue
        for f in files:
            paths.add(os.path.join(base, f))
    for s in glob.glob(SITES + '/*.json'):
        try:
            data = json.loads(read(s))
        except ValueError:
            continue
        if data.get('type') == 'external':
            for p in [data.get('file', '')] + data.get('links', []):
                for q in (p, p + '.disabled'):
                    if q and os.path.lexists(q):
                        paths.add(q)
    return paths

class Tx:
    """修改受管文件的事务：只快照 ngx 管理的配置和元数据（不含证书），失败自动恢复并重新加载。"""
    def __enter__(self):
        os.makedirs(os.path.dirname(LOCK), exist_ok=True)
        self.lock = open(LOCK, 'a')
        try:
            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Fail('另一个 ngx 正在修改配置，请稍后再试')
        self.snapshot = {}
        for p in managed_paths():
            if os.path.islink(p):
                self.snapshot[p] = ('link', os.readlink(p))
            elif os.path.isfile(p):
                with open(p, 'rb') as f:
                    self.snapshot[p] = ('file', f.read(), os.stat(p).st_mode & 0o7777)
        self.reloaded = False
        self.committed = False
        return self

    def apply(self):
        nginx_test()
        nginx_reload()
        self.reloaded = True

    def commit(self, quiet=False):
        self.apply()
        self.committed = True
        if not quiet:
            ok('配置已校验并生效')

    def rollback(self):
        for p in managed_paths() - set(self.snapshot):
            os.unlink(p)
        for p, item in self.snapshot.items():
            os.makedirs(os.path.dirname(p), exist_ok=True)
            if os.path.lexists(p):
                os.unlink(p)
            if item[0] == 'link':
                os.symlink(item[1], p)
            else:
                with open(p, 'wb') as f:
                    f.write(item[1])
                os.chmod(p, item[2])
        if self.reloaded:
            try:
                nginx_test()
                nginx_reload()
            except Fail as e:
                err(f'恢复后重新加载失败：{e}')
                return
        warn('已撤销本次修改')

    def __exit__(self, kind, value, tb):
        try:
            if not self.committed and self.snapshot is not None:
                self.rollback()
        finally:
            self.lock.close()
        return False

def nginx_test():
    cmd = ['nginx', '-t'] + (['-p', ROOT + '/', '-c', ETC + '/nginx.conf'] if ROOT else [])
    p = run(cmd, check=False)
    if p.returncode:
        lines = [l for l in (p.stdout or '').splitlines() if 'emerg' in l or 'error' in l or 'failed' in l]
        raise Fail('nginx 配置校验失败：\n    ' + '\n    '.join(lines or (p.stdout or '').splitlines()[-5:]))

def nginx_reload():
    if systemctl_active('nginx'):
        sys_cmd(['systemctl', 'reload', 'nginx'])
    else:
        sys_cmd(['systemctl', 'start', 'nginx'])

# ---------- 网络探测 ----------
def public_ips(refresh=False):
    """本机公网 IPv4/IPv6，缓存 10 分钟；可在 /etc/ngx/config 用 IPV4= / IPV6= 固定。"""
    cache = f'{CACHE}/ip.json'
    fixed = config_get('IPV4'), config_get('IPV6')
    if any(fixed):
        return fixed
    if not refresh:
        try:
            if time.time() - os.stat(cache).st_mtime < 600:
                data = json.loads(read(cache))
                return data['v4'], data['v6']
        except (OSError, ValueError, KeyError):
            pass
    def fetch(flag, url, version):
        p = run(['curl', flag, '-fsS', '--max-time', '5', url], check=False)
        try:
            ip = ipaddress.ip_address((p.stdout or '').strip())
            return str(ip) if ip.version == version else ''
        except ValueError:
            return ''
    with concurrent.futures.ThreadPoolExecutor(2) as pool:
        v4 = pool.submit(fetch, '-4', 'https://api.ipify.org', 4)
        v6 = pool.submit(fetch, '-6', 'https://api6.ipify.org', 6)
        result = v4.result(), v6.result()
    if any(result):
        os.makedirs(CACHE, exist_ok=True)
        write(cache, json.dumps(dict(v4=result[0], v6=result[1])))
    return result

def resolve(host, timeout=3):
    with concurrent.futures.ThreadPoolExecutor(1) as pool:
        future = pool.submit(lambda: {a[4][0] for a in socket.getaddrinfo(host, None, proto=socket.IPPROTO_TCP)})
        try:
            return future.result(timeout)
        except Exception:
            return set()

def cf_networks():
    nets = []
    for line in read(CF_IPS).split():
        try:
            nets.append(ipaddress.ip_network(line))
        except ValueError:
            pass
    return nets

def dns_state(domain, ips=None, nets=None):
    """按公网解析判断：橙云 / 灰云（指向本机）/ 其他 / 未解析。"""
    if domain.startswith('*.'):
        domain = 'ngx-check' + domain[1:]
    addrs = resolve(domain)
    if not addrs:
        return '未解析'
    ips = ips if ips is not None else public_ips()
    nets = nets if nets is not None else cf_networks()
    parsed = [ipaddress.ip_address(a) for a in addrs]
    if nets and all(any(a in n for n in nets) for a in parsed):
        return '橙云'
    if all(a in [ipaddress.ip_address(i) for i in ips if i] for a in parsed):
        return '灰云'
    return '其他'

def reachable(upstream, timeout=0.8):
    if not upstream:
        return None
    host, port = upstream_addr(upstream)
    try:
        if host == 'unix':
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(timeout)
            s.connect(ROOT + port)
            s.close()
        else:
            socket.create_connection((host, port), timeout).close()
        return True
    except OSError:
        return False

def listeners():
    """[(port, addr, process)]，来自 ss。"""
    p = run(['ss', '-H', '-lntp'], check=False)
    result = []
    for line in (p.stdout or '').splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        addr, _, port = parts[3].rpartition(':')
        m = re.search(r'\(\("([^"]+)"', line)
        if port.isdigit():
            result.append((int(port), addr.strip('[]'), m[1] if m else '?'))
    return result

def check_port_free(port):
    for p, addr, proc in listeners():
        if p == port and proc != 'nginx':
            raise Fail(f'端口 {port} 已被 {proc} 占用')

# ---------- 防火墙（可选：本机有 fw 或 ufw 时才处理） ----------
def firewall_open_ports():
    if ROOT:
        return None
    if shutil.which('fw'):
        out = _ansi.sub('', run(['fw', 'status'], check=False).stdout or '')
        ports = set()
        for m in re.finditer(r'^\s*tcp\s+(\d+)(?:-(\d+))?\s', out, re.M):
            ports.update(range(int(m[1]), int(m[2] or m[1]) + 1))
        return ports
    if shutil.which('ufw'):
        out = run(['ufw', 'status'], check=False).stdout or ''
        if 'Status: active' not in out:
            return None
        return {int(m[1]) for m in re.finditer(r'^(\d+)(?:/tcp)?\s+ALLOW', out, re.M)}
    return None

def offer_firewall(port, name):
    ports = firewall_open_ports()
    if ports is None:
        if port not in (80, 443):
            hint(f'如有云安全组，请放行 TCP {port}')
        return
    for p in sorted({80, port} - ports):
        if OPEN_FW or confirm(f'防火墙未放行 TCP {p}，现在放行？', default=True):
            cmd = ['fw', 'open', str(p), 'tcp', f'ngx {name}'] if shutil.which('fw') else ['ufw', 'allow', f'{p}/tcp']
            if run(cmd, check=False).returncode == 0:
                ok(f'已放行 TCP {p}')
            else:
                warn(f'放行 TCP {p} 失败，请手动处理')
        else:
            hint(f'外网访问需要放行 TCP {p}（也请检查云安全组）')

# ---------- Cloudflare ----------
def token_load():
    if os.path.isfile(TOKEN) and not os.path.islink(TOKEN):
        return read(TOKEN).strip()
    return ''

class CF:
    def __init__(self, token=None):
        self.token = token if token is not None else token_load()
        if not re.fullmatch(r'[A-Za-z0-9_-]{20,256}', self.token or ''):
            raise Fail('还没有 Cloudflare Token：ngx cf token set')
        self._zones = None

    def req(self, method, path, body=None, params=None):
        url = CF_API + path + ('?' + urllib.parse.urlencode(params) if params else '')
        data = json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(url, data=data, method=method, headers={
            'Authorization': f'Bearer {self.token}', 'Content-Type': 'application/json'})
        try:
            with urllib.request.urlopen(request, timeout=20) as r:
                payload = json.load(r)
        except urllib.error.HTTPError as e:
            try:
                payload = json.load(e)
            except ValueError:
                raise Fail(f'Cloudflare 请求失败：HTTP {e.code}')
        except (urllib.error.URLError, OSError, ValueError) as e:
            raise Fail(f'连不上 Cloudflare：{e}')
        if not payload.get('success'):
            msgs = '；'.join(f'{x.get("code")} {x.get("message")}' for x in payload.get('errors', []))
            raise Fail(f'Cloudflare 拒绝：{msgs or "未知错误"}（Token 需要 Zone.DNS 编辑 + Zone 读取权限）')
        return payload

    def paged(self, path, params=None):
        items, page = [], 1
        while True:
            data = self.req('GET', path, params=dict(params or {}, per_page=100, page=page))
            items += data['result']
            if page >= data.get('result_info', {}).get('total_pages', 1):
                return items
            page += 1

    def zones(self):
        if self._zones is None:
            self._zones = [(z['id'], z['name'].lower()) for z in self.paged('/zones')]
        return self._zones

    def zone_for(self, name):
        name = name.lower().lstrip('*.')
        matches = [(len(z), zid, z) for zid, z in self.zones() if name == z or name.endswith('.' + z)]
        if not matches:
            raise Fail(f'{name} 不在这个 Token 能管理的域名里（ngx cf token test 查看）')
        _, zid, zone = max(matches)
        return zid, zone

    def records(self, zid, name=None):
        return self.paged(f'/zones/{zid}/dns_records', {'name': name} if name else None)

def cf_available():
    return bool(token_load())

def check_cf_port(site):
    allowed = CF_HTTPS_PORTS if site['tls'] else CF_HTTP_PORTS
    if site['port'] not in allowed:
        raise Fail(f'橙云只代理这些{"HTTPS" if site["tls"] else "HTTP"}端口：{", ".join(map(str, sorted(allowed)))}；'
                   f'当前 {site["port"]}，可 ngx set {site["name"]} port 443')

def ensure_dns(domain, proxied=None, cf=None):
    """让 domain 的 A/AAAA 指向本机；没有就创建，不对就修正。proxied=None 时保留现有云朵状态（新建默认灰云）。"""
    cf = cf or CF()
    v4, v6 = public_ips()
    if not (v4 or v6):
        raise Fail('获取不到本机公网 IP；可在 /etc/ngx/config 写 IPV4=x.x.x.x')
    zid, _ = cf.zone_for(domain)
    recs = cf.records(zid, domain)
    cname = [r for r in recs if r['type'] == 'CNAME']
    if cname:
        raise Fail(f'{domain} 已有 CNAME → {cname[0]["content"]}，请先删除：ngx dns rm {domain} CNAME')
    changes = []
    for kind, ip in (('A', v4), ('AAAA', v6)):
        same = [r for r in recs if r['type'] == kind]
        if not ip:
            if same:
                warn(f'{domain} 有 {kind} 记录 {same[0]["content"]}，但本机没有公网 IPv6，部分访客会连不上：ngx dns rm {domain} AAAA')
            continue
        if len(same) > 1:
            keep = [r for r in same if r['content'] == ip]
            if not keep:
                raise Fail(f'{domain} 有多条 {kind} 记录，请先清理：ngx dns ls {domain}')
            warn(f'{domain} 还有其他 {kind} 记录，访客可能被分到别的服务器')
            same = keep
        want = proxied if proxied is not None else (same[0]['proxied'] if same else False)
        if same:
            r = same[0]
            if r['content'] == ip and r.get('proxied') == want:
                continue
            cf.req('PATCH', f'/zones/{zid}/dns_records/{r["id"]}', dict(content=ip, proxied=want))
            changes.append(f'{kind} → {ip}')
        else:
            cf.req('POST', f'/zones/{zid}/dns_records', dict(type=kind, name=domain, content=ip, ttl=1, proxied=want))
            changes.append(f'{kind} {ip} 已创建')
    cloud = '橙云' if (proxied if proxied is not None else any(r.get('proxied') for r in recs if r['type'] in ('A', 'AAAA'))) else '灰云'
    if changes:
        ok(f'{domain} DNS：{"，".join(changes)}（{cloud}）')
    else:
        ok(f'{domain} DNS 已指向本机（{cloud}）')
    clear_cache()

def clear_cache():
    for p in glob.glob(CACHE + '/state-*'):
        os.unlink(p)

def cf_update_files():
    def fetch(url):
        req = urllib.request.Request(url, headers={'User-Agent': 'ngx'})
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.read().decode()
        except (urllib.error.URLError, OSError) as e:
            raise Fail(f'下载 Cloudflare 地址段失败：{e}')
    nets = []
    for url, version in (('https://www.cloudflare.com/ips-v4', 4), ('https://www.cloudflare.com/ips-v6', 6)):
        for line in fetch(url).split():
            net = ipaddress.ip_network(line, strict=True)
            if net.version != version or net.prefixlen < 8:
                raise Fail(f'Cloudflare 地址段异常：{line}')
            nets.append(net)
    if sum(n.version == 4 for n in nets) < 10 or not any(n.version == 6 for n in nets):
        raise Fail('Cloudflare 地址段数量异常，已放弃更新')
    ranges = [str(n) for n in dict.fromkeys(nets)]
    write(CF_IPS, '\n'.join(ranges) + '\n')
    write(f'{ETC}/conf.d/ngx-cloudflare-realip.conf', '\n'.join(
        [MARK] + [f'set_real_ip_from {r};' for r in ranges] +
        ['real_ip_header CF-Connecting-IP;', 'real_ip_recursive on;',
         '# 按原始连接地址判断是否来自 Cloudflare，供 cf-only 网站使用。',
         'geo $realip_remote_addr $ngx_cf_peer {', '    default 0;'] +
        [f'    {r} 1;' for r in ranges] + ['}']) + '\n')
    write(f'{ETC}/snippets/ngx-cloudflare-allow.conf', '\n'.join([MARK] + [f'allow {r};' for r in ranges] + ['deny all;']) + '\n')
    return len(ranges)

def install_cf_timer():
    if not re.fullmatch(r'/[\w./-]+', SELF):
        raise Fail('ngx 的安装路径不能含特殊字符')
    write(f'{SYSTEMD}/ngx-cf-update.service', f'''{MARK}
[Unit]
Description=ngx: update Cloudflare IP ranges
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
ExecStart={SELF} cf update
''')
    write(f'{SYSTEMD}/ngx-cf-update.timer', f'''{MARK}
[Unit]
Description=ngx: weekly Cloudflare IP ranges update
[Timer]
OnCalendar=weekly
RandomizedDelaySec=1h
Persistent=true
[Install]
WantedBy=timers.target
''')
    sys_cmd(['systemctl', 'daemon-reload'], check=False)
    sys_cmd(['systemctl', 'enable', '--now', 'ngx-cf-update.timer'], check=False)

def ensure_cf_ranges():
    if not cf_networks():
        n = cf_update_files()
        ok(f'已同步 Cloudflare 地址段（{n} 条）')
        install_cf_timer()

# ---------- 证书 ----------
def certbot(args):
    cmd = [os.environ.get('NGX_CERTBOT', 'certbot'), '--config-dir', LE, '--work-dir', ROOT + '/var/lib/letsencrypt',
           '--logs-dir', ROOT + '/var/log/letsencrypt'] + args
    if ROOT and 'NGX_CERTBOT' not in os.environ:
        raise Fail('测试根下需要设置 NGX_CERTBOT 桩')
    return run(cmd, check=False)

def choose_method(site, override=None):
    if override:
        return override
    if site['cert_method'] in ('http', 'dns'):
        method = site['cert_method']
    else:
        method = 'http'
        if cf_available():
            try:
                cf = CF()
                for d in site['domains']:
                    cf.zone_for(d)
                method = 'dns'
            except Fail:
                pass
    if method == 'http' and any(d.startswith('*.') for d in site['domains']):
        raise Fail('通配符证书需要 DNS 验证：先 ngx cf token set')
    return method

def http_selfcheck(domains):
    """在 webroot 放一个探针文件，经公网域名取回，提前发现 DNS/80 端口问题。"""
    token = 'ngx-check-' + secrets.token_hex(8)
    path = f'{WEB}/.well-known/acme-challenge/{token}'
    write(path, token)
    bad = []
    try:
        for d in domains:
            try:
                with urllib.request.urlopen(f'http://{d}/.well-known/acme-challenge/{token}', timeout=8) as r:
                    if r.read().decode().strip() != token:
                        bad.append(f'{d}：返回内容不对（是否指向了别的服务器？）')
            except Exception as e:
                bad.append(f'{d}：{getattr(e, "reason", e)}')
    finally:
        os.unlink(path)
    return bad

def hook_cmd(action):
    if not re.fullmatch(r'/[\w./-]+', SELF):
        raise Fail('ngx 的安装路径不能含特殊字符')
    return (f'NGX_ROOT={ROOT} ' if ROOT else '') + f'{SELF} {action}'

def issue(site, force=False, method=None):
    method = choose_method(site, method)
    label = 'DNS 验证（Cloudflare）' if method == 'dns' else 'HTTP 验证（80 端口）'
    print(f'  … 正在为 {", ".join(site["domains"])} 申请证书：{label}')
    if method == 'http':
        bad = http_selfcheck(site['domains'])
        for b in bad:
            warn(f'自检未通过 {b}')
        if bad:
            hint('常见原因：DNS 没指向本机、80 端口没放行（含云安全组）、Cloudflare 开了「始终使用 HTTPS」')
            if not confirm('仍然尝试向 Let\'s Encrypt 申请？', default=False):
                raise Fail('证书未申请；修好后运行 ngx cert issue ' + site['name'])
    args = ['certonly', '--non-interactive', '--agree-tos', '--cert-name', cert_name(site),
            '--deploy-hook', 'systemctl reload nginx']
    args += ['--force-renewal'] if force else ['--keep-until-expiring', '--expand']
    email = config_get('EMAIL')
    args += ['--email', email] if email else ['--register-unsafely-without-email']
    for d in site['domains']:
        args += ['-d', d]
    if method == 'dns':
        args += ['--manual', '--preferred-challenges', 'dns',
                 '--manual-auth-hook', hook_cmd('_dns-auth'), '--manual-cleanup-hook', hook_cmd('_dns-cleanup')]
    else:
        args += ['--webroot', '-w', WEB]
    p = certbot(args)
    if p.returncode or not cert_ready(site):
        detail = [l for l in (p.stdout or '').splitlines() if l.strip()][-12:]
        raise Fail('证书申请失败：\n    ' + '\n    '.join(detail))
    days, _ = cert_info(cert_files(site)[0])
    ok(f'证书就绪，{days} 天后到期，certbot 会自动续期')

def dns_hook(action):
    """certbot manual hook：在 Cloudflare 上创建/删除 _acme-challenge TXT。"""
    domain = os.environ.get('CERTBOT_DOMAIN', '').lower()
    value = os.environ.get('CERTBOT_VALIDATION', '')
    if not host_valid(domain) or not re.fullmatch(r'[A-Za-z0-9_-]+', value):
        raise Fail('certbot hook 参数无效')
    cf = CF()
    zid, _ = cf.zone_for(domain)
    name = '_acme-challenge.' + domain
    if action == '_dns-auth':
        r = cf.req('POST', f'/zones/{zid}/dns_records', dict(type='TXT', name=name, content=value, ttl=60))
        print(r['result']['id'])
        if os.environ.get('CERTBOT_REMAINING_CHALLENGES', '0') == '0':
            wait_txt(name, value)
    else:
        rid = os.environ.get('CERTBOT_AUTH_OUTPUT', '').strip()
        for r in cf.records(zid, name):
            if r['type'] == 'TXT' and r['content'].strip('"') == value and (not rid or r['id'] == rid):
                cf.req('DELETE', f'/zones/{zid}/dns_records/{r["id"]}')

def wait_txt(name, value, limit=90):
    # 通过 1.1.1.1 的 DoH 确认 TXT 已生效，比固定等待更快也更可靠。
    url = 'https://cloudflare-dns.com/dns-query?' + urllib.parse.urlencode(dict(name=name, type='TXT'))
    deadline = time.time() + limit
    while time.time() < deadline:
        try:
            req = urllib.request.Request(url, headers={'Accept': 'application/dns-json'})
            with urllib.request.urlopen(req, timeout=5) as r:
                answers = json.load(r).get('Answer', [])
            if any(value in a.get('data', '') for a in answers):
                time.sleep(5)
                return
        except Exception:
            pass
        time.sleep(3)

def renewal_has_hook(site):
    conf = read(f'{LE}/renewal/{cert_name(site)}.conf')
    return bool(re.search(r'^\s*(deploy_hook|renew_hook)\s*=.*systemctl reload nginx', conf, re.M))

def add_renewal_hook(site):
    path = f'{LE}/renewal/{cert_name(site)}.conf'
    lines = read(path).splitlines()
    if not lines:
        raise Fail('找不到续期配置')
    if '[renewalparams]' not in lines:
        lines.append('[renewalparams]')
    lines.insert(lines.index('[renewalparams]') + 1, 'renew_hook = systemctl reload nginx')
    write(path, '\n'.join(lines) + '\n')

# ---------- 命令：增删改 ----------
def default_name(domain):
    base = re.sub(r'[^\w-]', '-', domain.lstrip('*.').split('.')[0]).strip('-_')[:40] or 'site'
    name, i = base, 2
    while os.path.exists(site_path(name)) or name == 'acme-80':
        name, i = f'{base}-{i}', i + 1
    return name

def domain_owner(domain, skip=None):
    for s in all_sites():
        if s['name'] != skip and domain in s.get('domains', []):
            return s['name']
    return None

def cmd_add(a):
    domains = parse_domains(a.domain)
    for d in domains:
        owner = domain_owner(d)
        if owner:
            raise Fail(f'{d} 已属于网站 {owner}')
    name = a.name or default_name(domains[0])
    if not name_valid(name):
        raise Fail(f'网站名称无效：{name}')
    if os.path.exists(site_path(name)):
        raise Fail(f'网站 {name} 已存在')
    site = dict(DEFAULTS, name=name, domains=domains, tls=not a.no_tls,
                created=datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))
    site['routes'], site['allow'] = [], []
    site['port'] = parse_port(a.port) if a.port else (443 if site['tls'] else 80)
    if a.backend.startswith('/') and not a.backend.startswith('//'):
        site['type'], site['root'] = 'static', os.path.normpath(a.backend)
        if not os.path.isdir(ROOT + site['root']):
            warn(f'目录 {site["root"]} 还不存在')
    else:
        site['upstream'] = parse_upstream(a.backend)
    if a.proxied:
        site['cloudflare'] = True
    if a.cf_only:
        site['cloudflare'] = site['cf_only'] = True
    if a.no_headers:
        site['headers'] = False
    if a.email:
        if not re.fullmatch(r'[^@\s]+@[^@\s]+\.[a-zA-Z]{2,}', a.email):
            raise Fail('邮箱格式无效')
        config_set('EMAIL', a.email)
    validate(site)
    if site['cloudflare']:
        check_cf_port(site)
    if site['port'] not in (80, 443):
        check_port_free(site['port'])
    if site['type'] == 'proxy' and reachable(site['upstream']) is False:
        warn(f'后端 {short_upstream(site["upstream"])} 现在连不上，网站会先返回 502')

    title(f'新建网站 {name}')
    # 1. DNS：有 Token 就自动解析，没有就提示。
    dns_done = False
    if not a.no_dns and cf_available():
        try:
            cf = CF()
            for d in domains:
                if d.startswith('*.'):
                    continue
                ensure_dns(d, proxied=True if site['cloudflare'] else None, cf=cf)
            dns_done = True
        except Fail as e:
            warn(f'DNS 未自动处理：{e}')
    if not dns_done:
        v4, v6 = public_ips()
        for d in domains:
            state = dns_state(d)
            if state not in ('灰云', '橙云'):
                warn(f'{d} 还没指向本机（当前：{state}）；请添加 A 记录 → {v4 or v6 or "本机公网 IP"}')
                hint('或者先 ngx cf token set，以后 ngx 会自动解析')
    with Tx() as tx:
        layout()
        if site['cloudflare']:
            ensure_cf_ranges()
        save(site)
        generate(site)
        symlink(conf_path(name), link_path(name))
        tx.apply()
        cert_error = None
        if site['tls'] and needs_cert(site):
            try:
                issue(site, method='dns' if a.dns else 'http' if a.http else None)
                generate(site)
            except Fail as e:
                cert_error = e
        tx.commit(quiet=True)
    if cert_error:
        warn(f'网站 {name} 已创建，但证书还没签下来，HTTPS 暂时无法访问')
    else:
        ok(f'网站 {name} 已上线')
    offer_firewall(site['port'], name)
    scheme = 'https' if site['tls'] else 'http'
    port = '' if site['port'] == (443 if site['tls'] else 80) else f':{site["port"]}'
    print(f'\n  {bold("访问地址")}  {scheme}://{domains[0]}{port}')
    hint(f'后端 {short_upstream(site["upstream"]) or site["root"]}  ·  管理：ngx show {name}')
    if cert_error:
        err(str(cert_error))
        hint(f'修好后运行：ngx cert issue {name}')
        raise SystemExit(1)

def cmd_rm(a):
    site = load(a.name)
    if site['type'] == 'external':
        raise Fail('手写配置的网站不会被删除；可以 ngx disable 停用，或 ngx forget 不再管理')
    if not confirm(f'删除网站 {site["name"]}（{", ".join(site["domains"])}）？', default=False):
        raise Fail('已取消')
    with Tx() as tx:
        for p in (link_path(site['name']), conf_path(site['name']), site_path(site['name']), f'{HTPASSWD}/{site["name"]}'):
            if os.path.lexists(p):
                os.unlink(p)
        tx.commit(quiet=True)
    ok(f'网站 {site["name"]} 已删除')
    if os.path.exists(f'{CUSTOM}/{site["name"]}.conf'):
        hint(f'自定义片段保留在 {CUSTOM}/{site["name"]}.conf')
    if a.purge_cert and cert_ready(site):
        certbot(['delete', '--non-interactive', '--cert-name', cert_name(site)])
        ok('证书已删除')
    if a.dns and cf_available():
        dns_remove_site(site)

def dns_remove_site(site):
    cf = CF()
    v4, v6 = public_ips()
    for d in site['domains']:
        zid, _ = cf.zone_for(d)
        for r in cf.records(zid, d):
            if r['type'] in ('A', 'AAAA') and r['content'] in (v4, v6):
                cf.req('DELETE', f'/zones/{zid}/dns_records/{r["id"]}')
                ok(f'已删除 DNS {r["type"]} {d}')

def modify(name, change, recert=False):
    """读取 → change(site) → 校验并生成 → 必要时签证书 → 生效；失败整体回滚。"""
    site = load(name)
    if site['type'] == 'external':
        raise Fail(f'{name} 是手写配置：ngx edit {name} 直接改，或 ngx adopt-convert 转为 ngx 管理')
    change(site)
    validate(site)
    with Tx() as tx:
        layout()
        if site['cloudflare']:
            ensure_cf_ranges()
        save(site)
        generate(site)
        if recert and site['tls'] and needs_cert(site):
            if enabled(site):
                tx.apply()
            issue(site)
            generate(site)
        tx.commit()
    return site

def cmd_set(a):
    field, value = a.field, a.value
    def change(site):
        if field == 'domain':
            site['domains'] = parse_domains(value)
            for d in site['domains']:
                owner = domain_owner(d, skip=site['name'])
                if owner:
                    raise Fail(f'{d} 已属于网站 {owner}')
        elif field in ('backend', 'upstream'):
            if value.startswith('/'):
                site['type'], site['root'], site['upstream'] = 'static', os.path.normpath(value), ''
            else:
                site['type'], site['upstream'] = 'proxy', parse_upstream(value)
        elif field == 'port':
            site['port'] = parse_port(value)
            if site['port'] not in (80, 443):
                check_port_free(site['port'])
        elif field == 'tls':
            site['tls'] = parse_bool(value)
            if site['tls'] and site['port'] == 80:
                site['port'] = 443
            if not site['tls'] and site['port'] == 443:
                site['port'] = 80
        elif field == 'body':
            site['body'] = parse_size(value)
        elif field == 'timeout':
            if not re.fullmatch(r'[1-9][0-9]{0,5}', value):
                raise Fail('超时为秒数，例如 3600')
            site['timeout'] = int(value)
        elif field == 'buffering':
            site['buffering'] = parse_bool(value)
        elif field == 'headers':
            site['headers'] = parse_bool(value)
        elif field == 'cf-only':
            site['cf_only'] = parse_bool(value)
            if site['cf_only']:
                site['cloudflare'] = True
        elif field == 'cert-method':
            if value not in ('auto', 'http', 'dns'):
                raise Fail('cert-method 为 auto、http 或 dns')
            site['cert_method'] = value
        else:
            raise Fail(f'不支持的字段：{field}')
    site = modify(a.name, change, recert=field in ('domain', 'tls'))
    if field == 'domain' and cf_available() and confirm('同时把新域名解析到本机？', default=True):
        for d in site['domains']:
            if not d.startswith('*.'):
                ensure_dns(d)
    if field == 'port':
        offer_firewall(site['port'], site['name'])

def cmd_route(a):
    if a.action == 'ls':
        site = load(a.name)
        rows = [(r['path'], short_upstream(r['upstream'])) for r in site['routes']]
        rows.append(('/', short_upstream(site['upstream']) or site['root'] + '（静态）'))
        table(['路径', '后端'], rows)
        return
    path = parse_route_path(a.path)
    if path in ('/', '=/'):
        raise Fail('根路径 / 用 ngx set <网站> backend 修改')
    def change(site):
        routes = [r for r in site['routes'] if r['path'] != path]
        if a.action == 'add':
            if not a.backend:
                raise Fail('用法：ngx route add <网站> <路径> <后端>')
            routes.append(dict(path=path, upstream=parse_upstream(a.backend)))
        elif len(routes) == len(site['routes']):
            raise Fail(f'没有路由 {path}')
        site['routes'] = sorted(routes, key=lambda r: (-len(r['path']), r['path']))
    modify(a.name, change)

def cmd_auth(a):
    site = load(a.name)
    if a.action == 'off':
        modify(a.name, lambda s: s.update(auth=False))
        return
    if not re.fullmatch(r'[A-Za-z0-9_.@-]{1,64}', a.user or ''):
        raise Fail('用法：ngx auth <网站> set <用户名>')
    password = sys.stdin.readline().strip() if not sys.stdin.isatty() else getpass.getpass('  密码: ')
    if len(password) < 6:
        raise Fail('密码至少 6 位')
    hashed = run(['openssl', 'passwd', '-5', '-stdin'], input=password + '\n').stdout.strip()
    path = f'{HTPASSWD}/{site["name"]}'
    lines = [l for l in read(path).splitlines() if l.split(':', 1)[0] != a.user]
    os.makedirs(HTPASSWD, mode=0o750, exist_ok=True)
    def change(s):
        write(path, '\n'.join(lines + [f'{a.user}:{hashed}']) + '\n', 0o640)
        try:
            shutil.chown(path, group='www-data')
        except (LookupError, OSError):
            os.chmod(path, 0o644)
        s['auth'] = True
    modify(a.name, change)
    ok(f'{site["name"]} 已开启密码访问（用户 {a.user}）')

def cmd_allow(a):
    def change(site):
        allow = list(site['allow'])
        if a.action == 'clear':
            allow = []
        else:
            try:
                net = str(ipaddress.ip_network(a.cidr or '', strict=False))
            except ValueError:
                raise Fail('需要 IP 或网段，例如 1.2.3.4 或 10.0.0.0/8')
            if a.action == 'add' and net not in allow:
                allow.append(net)
            elif a.action == 'rm':
                allow = [x for x in allow if x != net]
        site['allow'] = allow
    if a.action == 'ls':
        site = load(a.name)
        print('\n'.join(f'  {x}' for x in site['allow']) or '  （不限制）')
        return
    site = modify(a.name, change)
    hint('允许：' + ('、'.join(site['allow']) or '所有人'))

def cmd_toggle(a, on):
    site = load(a.name)
    with Tx() as tx:
        if site['type'] == 'external':
            toggle_external(site, on)
        elif on:
            generate(site)
            symlink(conf_path(site['name']), link_path(site['name']))
        elif os.path.lexists(link_path(site['name'])):
            os.unlink(link_path(site['name']))
        tx.commit(quiet=True)
    ok(f'网站 {site["name"]} 已{"启用" if on else "停用"}')

def toggle_external(site, on):
    file = site['file']
    if file.startswith(ETC + '/conf.d/'):
        src, dst = (file + '.disabled', file) if on else (file, file + '.disabled')
        if os.path.exists(src):
            os.replace(src, dst)
        return
    links = site.get('links') or [f'{ETC}/sites-enabled/{os.path.basename(file)}']
    for link in links:
        if on and not os.path.lexists(link):
            os.symlink(file, link)
        elif not on and os.path.islink(link):
            os.unlink(link)
        elif not on and os.path.exists(link):
            raise Fail(f'{link} 是实体文件，无法停用')
    site['links'] = links
    save(site)

def cmd_edit(a):
    site = load(a.name)
    editor = os.environ.get('EDITOR') or ('nano' if shutil.which('nano') else 'vi')
    with Tx() as tx:
        if site['type'] == 'external':
            path = site['file'] if os.path.exists(site['file']) else site['file'] + '.disabled'
            subprocess.call([editor, path])
        else:
            path = f'{CUSTOM}/{site["name"]}.conf'
            if not os.path.exists(path):
                write(path, f'# {site["name"]} 的自定义 nginx 片段，会被 include 到 server {{}} 里，ngx 重新生成配置时保留。\n'
                            f'# 例如：location /ws/ {{ include {ETC}/snippets/ngx-proxy.conf; proxy_pass http://127.0.0.1:9000; }}\n')
            subprocess.call([editor, path])
            generate(site)
        tx.commit()

def cmd_show(a):
    site = find_site(a.name)
    title(f'{site["name"]} · {", ".join(site["domains"])}')
    if site['type'] == 'external':
        rows = [('类型', '手写配置'), ('文件', site['file']), ('启用', '是' if enabled(site) else '否')]
        if site.get('cert'):
            days, _ = cert_info(site['cert'])
            rows.append(('证书', f'{site["cert"]}（剩 {days} 天）'))
        table(['项目', '值'], rows)
        return
    days, _ = cert_info(cert_files(site)[0])
    rows = [
        ('后端', short_upstream(site['upstream']) or f'{site["root"]}（静态）'),
        ('监听端口', site['port']),
        ('HTTPS', ('是，' + (f'证书剩 {days} 天' if days is not None else '证书未签发')) if site['tls'] else '否'),
        ('证书验证', {'auto': '自动', 'http': 'HTTP', 'dns': 'DNS'}[site['cert_method']]),
        ('Cloudflare', ('仅允许 CF 访问' if site['cf_only'] else '开启') if site['cloudflare'] else '关闭'),
        ('上传上限', site['body']), ('超时', f'{site["timeout"]}s'), ('缓冲', '开' if site['buffering'] else '关'),
        ('安全响应头', '开' if site['headers'] else '关'), ('密码访问', '开' if site['auth'] else '关'),
        ('IP 白名单', '、'.join(site['allow']) or '不限'), ('启用', '是' if enabled(site) else '否'),
    ]
    for r in site['routes']:
        rows.append((f'路由 {r["path"]}', short_upstream(r['upstream'])))
    if os.path.exists(f'{CUSTOM}/{site["name"]}.conf'):
        rows.append(('自定义片段', f'{CUSTOM}/{site["name"]}.conf'))
    table(['项目', '值'], rows)
    if a.config:
        print()
        print(read(conf_path(site['name'])))

# ---------- 命令：状态 ----------
def site_row(site, ips, nets):
    on = enabled(site)
    up = reachable(site.get('upstream', '')) if on and site['type'] == 'proxy' else None
    status = dim('○ 停用') if not on else yellow('● 后端不通') if up is False else green('● 在线')
    if site['type'] == 'external':
        days, _ = cert_info(site.get('cert', '')) if site.get('cert') else (None, set())
        tls = bool(site.get('cert'))
    else:
        days, _ = cert_info(cert_files(site)[0])
        tls = site['tls']
    if not tls:
        cert = dim('未启用')
    elif days is None:
        cert = red('未签发')
    elif days < 14:
        cert = red(f'剩 {days} 天')
    else:
        cert = f'剩 {days} 天'
    domain = site['domains'][0] if site.get('domains') else ''
    state = cached_state(domain, ips, nets) if domain else '—'
    cloud = {'橙云': yellow('橙云'), '灰云': '灰云', '未解析': red('未解析'), '其他': red('非本机')}.get(state, state)
    backend = short_upstream(site.get('upstream', '')) or site.get('root', '') or ('手写配置' if site['type'] == 'external' else '')
    more = f' +{len(site["domains"]) - 1}' if len(site.get('domains', [])) > 1 else ''
    return [site['name'], domain + more, backend, status, cert, cloud]

def cached_state(domain, ips, nets):
    path = f'{CACHE}/state-{domain}'
    try:
        if time.time() - os.stat(path).st_mtime < 120:
            return read(path).strip()
    except OSError:
        pass
    state = dns_state(domain, ips, nets)
    try:
        os.makedirs(CACHE, exist_ok=True)
        write(path, state)
    except OSError:
        pass
    return state

def site_rows(sites):
    ips, nets = public_ips(), cf_networks()
    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        return list(pool.map(lambda s: site_row(s, ips, nets), sites))

def cmd_ls(a):
    sites = all_sites()
    if not sites:
        hint('还没有网站。新建：ngx add 域名 端口，例如 ngx add app.example.com 3000')
        return
    rows = site_rows(sites)
    table(['网站', '域名', '后端', '状态', 'HTTPS', 'DNS'], rows)

def cmd_status(a):
    state = green('运行中') if systemctl_active('nginx') else red('未运行')
    v4, v6 = public_ips()
    title('nginx')
    print(f'  {state}  ·  {run(["nginx", "-v"], check=False).stdout.strip()}  ·  公网 IP {v4 or "-"} {v6 or ""}')
    print(f'  Cloudflare Token：{"已设置" if cf_available() else "未设置"}  ·  证书自动续期：{"开启" if systemctl_active("certbot.timer") else red("未开启")}')
    title('网站')
    cmd_ls(a)
    others = [p for p in glob.glob(ETC + '/sites-enabled/*') + glob.glob(ETC + '/conf.d/*.conf')
              if not os.path.basename(p).startswith('ngx-') and not any(
                  os.path.realpath(p) == os.path.realpath(s.get('file', '')) for s in all_sites())]
    if others:
        title('其他 nginx 配置（未纳入管理，可 ngx adopt）')
        for p in others:
            hint(p)

def cmd_scan(a):
    used = set()
    for s in all_sites():
        for u in [s.get('upstream', '')] + [r['upstream'] for r in s.get('routes', [])]:
            if u and not u.startswith('unix:'):
                used.add(upstream_addr(u)[1])
    rows, seen = [], set()
    for port, addr, proc in sorted(listeners()):
        if proc in ('nginx', 'sshd') or port in seen:
            continue
        seen.add(port)
        scope = '仅本机' if addr in ('127.0.0.1', '::1') or addr.startswith('127.') else '所有地址'
        rows.append([str(port), proc, scope, green('已反代') if port in used else ''])
    if not rows:
        hint('没有发现正在监听的服务')
        return rows
    table(['端口', '程序', '监听', ''], rows)
    hint('反代某个端口：ngx add 域名 端口')
    return rows

def cmd_doctor(a):
    findings = doctor_findings()
    if not findings:
        ok('一切正常')
        return
    for level, msg, fix in findings:
        (err if level == 'error' else warn)(msg + (dim(f'  → 可自动修复') if fix else ''))
    fixable = [f for f in findings if f[2]]
    if fixable and (a.fix or (sys.stdin.isatty() and confirm(f'自动修复 {len(fixable)} 项？', default=True))):
        for level, msg, fix in fixable:
            try:
                fix()
            except Fail as e:
                err(f'{msg}：修复失败 {e}')
    if any(f[0] == 'error' for f in findings):
        raise SystemExit(1)

def doctor_findings():
    out = []
    def add(level, msg, fix=None):
        out.append((level, msg, fix))
    if not systemctl_active('nginx'):
        add('error', 'nginx 没有运行', lambda: (nginx_test(), sys_cmd(['systemctl', 'restart', 'nginx'])))
    try:
        nginx_test()
    except Fail as e:
        add('error', str(e))
    if os.path.lexists(f'{ETC}/sites-enabled/default') or not os.path.exists(f'{ETC}/sites-enabled/ngx-acme-80.conf'):
        add('warn', '基础配置不完整（default 站点仍启用或缺少 ACME 入口）', lambda: run_tx(layout))
    if not systemctl_active('certbot.timer') and shutil.which('certbot'):
        add('warn', 'certbot 自动续期定时器未运行', lambda: sys_cmd(['systemctl', 'enable', '--now', 'certbot.timer']))
    sites = all_sites()
    ips, nets = public_ips(), cf_networks()
    if any(s.get('cloudflare') for s in sites):
        try:
            age = time.time() - os.stat(CF_IPS).st_mtime
        except OSError:
            age = 1e9
        if age > 30 * 86400:
            add('warn', 'Cloudflare 地址段超过 30 天没更新', lambda: run_tx(cf_update_files))
    for s in sites:
        n = s['name']
        on = enabled(s)
        if s['type'] == 'external':
            if s.get('cert'):
                days, _ = cert_info(s['cert'])
                if days is None or days < 14:
                    add('warn', f'{n}：手写配置的证书剩 {days} 天')
            continue
        if on and s['type'] == 'proxy' and reachable(s['upstream']) is False:
            add('warn', f'{n}：后端 {short_upstream(s["upstream"])} 连不上（服务没启动？）')
        for r in s['routes']:
            if on and reachable(r['upstream']) is False:
                add('warn', f'{n}：路由 {r["path"]} 的后端 {short_upstream(r["upstream"])} 连不上')
        if s['tls']:
            days, names = cert_info(cert_files(s)[0])
            if days is None:
                add('error', f'{n}：证书未签发', lambda s=s: cmd_cert_issue_site(s))
            elif days < 14:
                add('error', f'{n}：证书剩 {days} 天，续期可能失败了', lambda s=s: cmd_cert_issue_site(s, force=True))
            elif not set(s['domains']) <= names:
                add('error', f'{n}：证书不包含全部域名', lambda s=s: cmd_cert_issue_site(s))
            elif not renewal_has_hook(s):
                add('warn', f'{n}：续期后不会自动重载 nginx', lambda s=s: add_renewal_hook(s))
        for d in s['domains']:
            state = dns_state(d, ips, nets)
            if state in ('未解析', '其他'):
                fix = (lambda d=d: ensure_dns(d)) if cf_available() and not d.startswith('*.') else None
                add('warn', f'{n}：{d} {"没有解析" if state == "未解析" else "没有指向本机"}', fix)
            elif state == '橙云' and not s['cloudflare']:
                add('warn', f'{n}：{d} 是橙云，但网站没开 Cloudflare 模式（访客真实 IP 会丢失）',
                    lambda n=n: modify(n, lambda x: x.update(cloudflare=True)))
            elif state == '橙云' and s['tls'] and s['port'] not in CF_HTTPS_PORTS:
                add('error', f'{n}：橙云不代理 {s["port"]} 端口')
    return out

def run_tx(fn):
    with Tx() as tx:
        fn()
        tx.commit()

# ---------- 命令：证书 ----------
def cmd_cert_issue_site(site, force=False, method=None):
    with Tx() as tx:
        site['tls'] = True
        if site['port'] == 80:
            site['port'] = 443
        if method:
            site['cert_method'] = method
        save(site)
        generate(site)
        if enabled(site):
            tx.apply()
        issue(site, force=force, method=method)
        generate(site)
        tx.commit()

def cmd_cert(a):
    if a.action == 'issue':
        site = load(a.name or '')
        if site['type'] == 'external':
            raise Fail('手写配置的网站请自行用 certbot 续期')
        if not needs_cert(site) and not a.force:
            days, _ = cert_info(cert_files(site)[0])
            ok(f'证书有效（剩 {days} 天），无需重签；强制重签加 --force')
            return
        cmd_cert_issue_site(site, a.force, 'dns' if a.dns else 'http' if a.http else None)
    elif a.action == 'renew':
        args = ['renew', '--deploy-hook', 'systemctl reload nginx'] + (['--dry-run'] if a.dry_run else [])
        if a.name:
            args += ['--cert-name', cert_name(load(a.name))]
        p = certbot(args)
        print(p.stdout)
        if p.returncode:
            raise Fail('续期有失败项，见上方输出')
    elif a.action == 'list':
        rows = []
        for path in sorted(glob.glob(f'{LE}/live/*/fullchain.pem')):
            days, names = cert_info(path)
            users = [s['name'] for s in all_sites() if cert_files(s)[0] == path]
            rows.append([path.split('/')[-2], ', '.join(sorted(names)), f'{days} 天' if days is not None else '?', '、'.join(users) or dim('未使用')])
        table(['证书', '域名', '剩余', '网站'], rows) if rows else hint('还没有证书')
    elif a.action == 'rm':
        name = a.name or ''
        for s in all_sites():
            if s['type'] != 'external' and cert_name(s) == name and s['tls']:
                raise Fail(f'网站 {s["name"]} 正在使用这张证书')
        if not os.path.isdir(f'{LE}/live/{name}'):
            raise Fail(f'没有证书 {name}（ngx cert list 查看）')
        if confirm(f'删除证书 {name}？', default=False):
            p = certbot(['delete', '--non-interactive', '--cert-name', name])
            if p.returncode:
                raise Fail(p.stdout)
            ok('证书已删除')

