#!/usr/bin/env bash
# fw —— nftables 防火墙管理工具
# 规则保存在 /etc/fw/ 下，由本脚本生成 /etc/nftables.conf 并加载。
# 直接运行 fw 进入交互菜单，fw help 查看命令行用法。

export LC_ALL=C.UTF-8
set -o pipefail

FW_DIR=/etc/fw
PORTS=$FW_DIR/ports          # 每行：协议 端口[-端口] 备注
BLOCKS=$FW_DIR/blocklist     # 每行：IP或网段 备注
ALLOWS=$FW_DIR/allowlist     # 每行：IP或网段 备注（始终放行）
NFT_CONF=/etc/nftables.conf
F2B_IGNORE=/etc/fail2ban/jail.d/fw-allowlist.local

if [[ -t 1 ]]; then
	R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' D=$'\e[2m' BD=$'\e[1m' N=$'\e[0m'
else
	R='' G='' Y='' C='' D='' BD='' N=''
fi

ok()    { echo "  ${G}✔${N} $*"; }
warn()  { echo "  ${Y}!${N} $*"; }
err()   { echo "  ${R}✘${N} $*" >&2; }
die()   { err "$*"; exit 1; }
hint()  { echo "  ${D}$*${N}"; }
title() { echo; echo "${BD}${C}■ $*${N}"; }

# 按终端显示宽度补齐空格（中文占 2 列）
pad() {
	local s=$1 w=$2 wide=${1//[[:ascii:]]/}
	local len=$(( ${#s} + ${#wide} ))
	printf '%s%*s' "$s" $(( w > len ? w - len : 0 )) ''
}

[[ $EUID -eq 0 ]] || die "需要 root 权限运行"
command -v nft >/dev/null || die "未安装 nftables（apt install nftables）"

# ---------- 基础工具 ----------

ssh_ports() { sshd -T 2>/dev/null | awk '$1=="port"{print $2}'; }

is_ssh_port() { # 端口区间是否包含 SSH 端口
	local lo=$1 hi=$2 p
	for p in $(ssh_ports); do (( p >= lo && p <= hi )) && return 0; done
	return 1
}

# 校验并规范化端口或区间：输出 "80" 或 "8000-8100"
norm_port() {
	local a b
	if [[ $1 =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
		a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]}))
	elif [[ $1 =~ ^[0-9]{1,5}$ ]]; then
		a=$((10#$1)) b=$a
	else
		return 1
	fi
	(( a >= 1 && b <= 65535 && a <= b )) || return 1
	(( a == b )) && echo "$a" || echo "$a-$b"
}
lo_of() { echo "${1%-*}"; }
hi_of() { echo "${1#*-}"; }

norm_proto() {
	case ${1,,} in
		''|1|tcp) echo tcp ;;
		2|udp) echo udp ;;
		3|both|all|tcp+udp) echo both ;;
		*) return 1 ;;
	esac
}

# 输出与给定协议/区间重叠的已放行规则
find_overlap() {
	local proto=$1 lo hi
	lo=$(lo_of "$2") hi=$(hi_of "$2")
	awk -v p="$proto" -v lo="$lo" -v hi="$hi" '
		$1 == p { n = split($2, r, "-"); a = r[1]; b = (n > 1) ? r[2] : r[1]
		          if (a + 0 <= hi + 0 && lo + 0 <= b + 0) print $2 }' "$PORTS"
}

port_open() { # 某协议的某个端口是否已放行
	[[ -n $(find_overlap "$1" "$2") ]]
}

# 校验 IP / 网段，输出规范形式
norm_net() {
	python3 - "$1" 2>/dev/null <<'PY'
import ipaddress, sys
n = ipaddress.ip_network(sys.argv[1], strict=False)
print(n.network_address if n.prefixlen == n.max_prefixlen else n)
PY
}
nets_overlap() {
	python3 -c 'import ipaddress,sys; a,b=(ipaddress.ip_network(x,strict=False) for x in sys.argv[1:]); sys.exit(0 if a.version==b.version and a.overlaps(b) else 1)' "$1" "$2" 2>/dev/null
}
# 输出列表文件中与给定网段重叠的条目
find_net_overlap() {
	local n
	for n in $(awk 'NF {print $1}' "$2"); do nets_overlap "$1" "$n" && echo "$n"; done
}
net_contains() {
	python3 -c 'import ipaddress,sys; sys.exit(0 if ipaddress.ip_address(sys.argv[2]) in ipaddress.ip_network(sys.argv[1]) else 1)' "$1" "$2" 2>/dev/null
}
# 当前登录用户的来源 IP（防止把自己封了）
my_ips() {
	{ [[ -n $SSH_CLIENT ]] && echo "${SSH_CLIENT%% *}"; who 2>/dev/null | sed -n 's/.*(\(.*\))$/\1/p'; } | sort -u
}

note_text() { [[ $1 == - ]] && echo "" || echo "$1"; }

# ---------- 状态文件与配置生成 ----------

init_state() {
	mkdir -p "$FW_DIR"
	[[ -f $BLOCKS ]] || : > "$BLOCKS"
	[[ -f $ALLOWS ]] || : > "$ALLOWS"
	if [[ ! -s $PORTS ]]; then
		local p ports
		ports=$(ssh_ports)
		[[ -n $ports ]] || die "检测不到 SSH 端口，为避免把自己锁在外面，已停止"
		for p in $ports; do echo "tcp $p SSH"; done > "$PORTS"
	fi
}

join_list() { paste -sd, - | sed 's/,/, /g'; }
elems() { [[ -n $1 ]] && printf '\t\telements = { %s }' "$1"; }

gen_conf() {
	local tcp udp b4 b6 a4 a6
	tcp=$(awk '$1=="tcp"{print $2}' "$PORTS" | join_list)
	udp=$(awk '$1=="udp"{print $2}' "$PORTS" | join_list)
	b4=$(awk 'NF && $1 !~ /:/ {print $1}' "$BLOCKS" | join_list)
	b6=$(awk '$1 ~ /:/ {print $1}' "$BLOCKS" | join_list)
	a4=$(awk 'NF && $1 !~ /:/ {print $1}' "$ALLOWS" | join_list)
	a6=$(awk '$1 ~ /:/ {print $1}' "$ALLOWS" | join_list)
	cat <<EOF
#!/usr/sbin/nft -f
# 由 fw 自动生成，请勿手动修改。改规则请用 fw 命令（规则数据在 $FW_DIR/）。
# 不使用 "flush ruleset"，以免清掉 Docker 和 fail2ban 的规则，只重建自己的表。
table inet host
delete table inet host

table inet host {
	set tcp_open {
		type inet_service
		flags interval
		auto-merge
$(elems "$tcp")
	}

	set udp_open {
		type inet_service
		flags interval
		auto-merge
$(elems "$udp")
	}

	set block4 {
		type ipv4_addr
		flags interval
		auto-merge
$(elems "$b4")
	}

	set allow4 {
		type ipv4_addr
		flags interval
		auto-merge
$(elems "$a4")
	}

	set allow6 {
		type ipv6_addr
		flags interval
		auto-merge
$(elems "$a6")
	}

	set block6 {
		type ipv6_addr
		flags interval
		auto-merge
$(elems "$b6")
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		# 容器访问宿主机上的服务（docker0 是默认网络，br-* 是自建网络）
		iifname "docker0" accept
		iifname "br-*" accept
		# 白名单优先于黑名单和端口规则
		ip saddr @allow4 counter accept comment "allowlist"
		ip6 saddr @allow6 counter accept comment "allowlist"
		ip saddr @block4 counter drop comment "blocklist"
		ip6 saddr @block6 counter drop comment "blocklist"
		ct state established,related accept
		ct state invalid drop

		# ICMP（ping、PMTU 发现）；IPv6 邻居发现必须放行，否则 IPv6 会断
		ip protocol icmp accept
		ip6 nexthdr icmpv6 accept

		tcp dport @tcp_open counter accept comment "tcp_open"
		udp dport @udp_open counter accept comment "udp_open"

		# 其余流量丢弃前抽样记录日志（每分钟最多 5 条）
		limit rate 5/minute log prefix "nft-drop: " level info
		counter drop comment "dropped"
	}

	# 外部访问 Docker 发布的端口时，数据包经 DNAT 后走 forward 而不是 input，在这里统一管控。
	# 本链只做拦截：accept 仅表示"本链不拦"，之后仍由 Docker 自己的规则决定，不会破坏 Docker 网络。
	chain forward {
		type filter hook forward priority filter - 1; policy accept;

		# 容器发出的流量（容器之间、容器上网）不管
		iifname "docker0" accept
		iifname "br-*" accept

		ip saddr @allow4 counter accept comment "allowlist"
		ip6 saddr @allow6 counter accept comment "allowlist"
		ip saddr @block4 counter drop comment "blocklist"
		ip6 saddr @block6 counter drop comment "blocklist"
		ct state established,related accept

		# 按"宿主机上的端口"（DNAT 之前的端口）判断是否放行
		ct status dnat meta l4proto tcp ct original proto-dst != @tcp_open counter drop comment "dropped"
		ct status dnat meta l4proto udp ct original proto-dst != @udp_open counter drop comment "dropped"
	}
}
EOF
}

apply() { # 生成配置 → 校验 → 加载
	local tmp out
	tmp=$(mktemp)
	gen_conf > "$tmp"
	if ! out=$(nft -c -f "$tmp" 2>&1); then
		err "规则校验失败："; echo "$out" | sed 's/^/    /' >&2
		rm -f "$tmp"; return 1
	fi
	install -m 644 "$tmp" "$NFT_CONF"; rm -f "$tmp"
	if ! out=$(nft -f "$NFT_CONF" 2>&1); then
		err "规则加载失败："; echo "$out" | sed 's/^/    /' >&2
		return 1
	fi
	sync_f2b
}

# 把白名单同步为 fail2ban 的 ignoreip，白名单 IP 永远不会被 fail2ban 封禁
sync_f2b() {
	[[ -d ${F2B_IGNORE%/*} ]] || return 0
	local new
	new=$(printf '# 由 fw 自动生成，对应 %s\n[DEFAULT]\nignoreip = 127.0.0.1/8 ::1 %s\n' \
		"$ALLOWS" "$(awk 'NF {print $1}' "$ALLOWS" | paste -sd' ')")
	[[ -f $F2B_IGNORE && $(<"$F2B_IGNORE") == "$new" ]] && return 0
	echo "$new" > "$F2B_IGNORE"
	systemctl is-active -q fail2ban && fail2ban-client reload >/dev/null 2>&1
	return 0
}

STATE_FILES=("$PORTS" "$BLOCKS" "$ALLOWS")
save_state() { local f; for f in "${STATE_FILES[@]}"; do cp "$f" "$f.bak"; done; }
discard_state() { local f; for f in "${STATE_FILES[@]}"; do rm -f "$f.bak"; done; }
commit() { # 应用修改，失败则回滚
	if apply; then
		discard_state; return 0
	fi
	local f; for f in "${STATE_FILES[@]}"; do mv "$f.bak" "$f"; done
	apply >/dev/null 2>&1
	warn "已撤销本次修改，防火墙保持原样"
	return 1
}

# ---------- 监听端口 / Docker ----------

# LISTENERS 每项："协议 端口 public|local 程序名[,程序名]"
load_listeners() {
	mapfile -t LISTENERS < <(ss -Hlntup 2>/dev/null | awk '
		{ proto = $1; loc = $5
		  port = loc; sub(/.*:/, "", port)
		  addr = loc; sub(/:[^:]*$/, "", addr)
		  proc = "?"; if (match($0, /\(\("[^"]+"/)) proc = substr($0, RSTART + 3, RLENGTH - 4)
		  pub = (addr ~ /^(127\.|\[::1\]|::1)/) ? 0 : 1
		  k = proto " " port
		  if (!(k in P)) { P[k] = pub; X[k] = proc; o[++n] = k }
		  else { if (pub) P[k] = 1; if (index("," X[k] ",", "," proc ",") == 0) X[k] = X[k] "," proc } }
		END { for (i = 1; i <= n; i++) print o[i], (P[o[i]] ? "public" : "local"), X[o[i]] }' |
		sort -k1,1 -k2,2n)
}

# 某协议、端口区间内的监听者，输出 "端口 范围 程序"
listeners_in() {
	local proto=$1 lo=$2 hi=$3 l lp lport lscope lproc
	for l in "${LISTENERS[@]}"; do
		read -r lp lport lscope lproc <<<"$l"
		[[ $lp == "$proto" ]] && (( lport >= lo && lport <= hi )) && echo "$lport $lscope $lproc"
	done
}

# Docker 发布的端口，输出 "协议 宿主端口 public|local 容器名 容器端口"
docker_ports() {
	command -v docker >/dev/null || return 0
	docker ps --format '{{.Names}}\t{{.Ports}}' 2>/dev/null | awk -F'\t' '{
		n = split($2, a, ", ")
		for (i = 1; i <= n; i++) {
			if (a[i] !~ /->/) continue
			split(a[i], b, "->"); host = b[1]; cont = b[2]
			hp = host; sub(/.*:/, "", hp); ha = host; sub(/:[^:]*$/, "", ha)
			proto = cont; sub(/.*\//, "", proto); sub(/\/.*/, "", cont)
			scope = (ha ~ /^(127\.|\[::1\]|::1)/) ? "local" : "public"
			k = proto " " hp " " scope " " $1
			if (!(k in s)) { s[k] = 1; print proto, hp, scope, $1, cont }
		}}'
}

counter_of() { # 按规则注释汇总计数器
	nft list table inet host 2>/dev/null |
		awk -v c="comment \"$1\"" 'index($0, c) { for (i = 1; i <= NF; i++) if ($i == "packets") s += $(i + 1) } END { print s + 0 }'
}

f2b_banned() {
	command -v fail2ban-client >/dev/null || return 0
	fail2ban-client status sshd 2>/dev/null | sed -n 's/.*Banned IP list:\s*//p' | tr ' ' '\n' | sed '/^$/d'
}

# ---------- 命令 ----------

cmd_status() {
	load_listeners
	local active
	if nft list table inet host >/dev/null 2>&1; then
		active="${G}运行中${N}，入站默认拦截，只放行下方列出的端口"
	else
		active="${R}未加载${N}（执行 fw reload 加载规则）"
	fi

	title "防火墙概况"
	echo "  状态      $active"
	echo "  SSH 端口  $(ssh_ports | paste -sd' ')（受保护，不允许关闭）"
	echo "  已拦截    $(counter_of dropped) 个数据包（从上次加载规则起算）"

	title "已放行端口"
	printf "  ${D}%s%s%s%s${N}\n" "$(pad 协议 6)" "$(pad 端口 13)" "$(pad 监听程序 26)" "备注"
	local proto port note lo hi pub loc info
	while read -r proto port note; do
		[[ -z $proto ]] && continue
		lo=$(lo_of "$port") hi=$(hi_of "$port")
		pub=$(listeners_in "$proto" "$lo" "$hi" | awk '$2=="public"{print $3}' | tr ',' '\n' | sort -u | paste -sd,)
		loc=$(listeners_in "$proto" "$lo" "$hi" | awk '$2=="local"{print $3}' | tr ',' '\n' | sort -u | paste -sd,)
		if [[ -n $pub ]]; then
			info="${G}● $(pad "$pub" 24)${N}"
		elif [[ -n $loc ]]; then
			info="${Y}● $(pad "仅本机 $loc" 24)${N}"
		else
			info="${D}○ $(pad 无程序监听 24)${N}"
		fi
		note=$(note_text "$note")
		[[ $proto == tcp ]] && is_ssh_port "$lo" "$hi" && note="$note ${D}(受保护)${N}"
		printf "  %s%s%s%s\n" "$(pad "$proto" 6)" "$(pad "$port" 13)" "$info" "$note"
	done < "$PORTS"
	hint "● 绿色=可从外部访问  ● 黄色=程序只监听本机，外部仍访问不到  ○=放行了但没有程序在用"

	local l lp lport lscope lproc closed=() localonly=()
	for l in "${LISTENERS[@]}"; do
		read -r lp lport lscope lproc <<<"$l"
		[[ $lproc == docker-proxy ]] && continue
		if [[ $lscope == local ]]; then
			localonly+=("$lp/$lport $lproc")
		elif ! port_open "$lp" "$lport"; then
			closed+=("$l")
		fi
	done
	if (( ${#closed[@]} )); then
		title "正在监听但未放行（外部访问不到）"
		for l in "${closed[@]}"; do
			read -r lp lport lscope lproc <<<"$l"
			printf "  %s%s%s\n" "$(pad "$lp" 6)" "$(pad "$lport" 13)" "$lproc"
		done
		hint "需要对外开放的话：fw open <端口>"
	fi
	if (( ${#localonly[@]} )); then
		title "仅本机监听（不需要放行）"
		printf '  %s\n' "${localonly[@]}" | sed "s/^/${D}/; s/\$/${N}/"
	fi

	local dp
	dp=$(docker_ports)
	if [[ -n $dp ]]; then
		title "Docker 发布的端口"
		local name cport
		printf "  ${D}%s%s%s%s${N}\n" "$(pad 协议 6)" "$(pad 端口 13)" "$(pad 容器:容器端口 26)" "状态"
		while read -r proto port lscope name cport; do
			if [[ $lscope == local ]]; then
				info="${G}仅本机${N}"
			elif port_open "$proto" "$(lo_of "$port")"; then
				info="${G}● 对外开放${N}"
			else
				info="${Y}○ 已拦截${N} ${D}（fw open $port$([[ $proto == udp ]] && echo " udp") 放行）${N}"
			fi
			printf "  %s%s%s%s\n" "$(pad "$proto" 6)" "$(pad "$port" 13)" "$(pad "$name:$cport" 26)" "$info"
		done <<<"$dp"
		hint "Docker 发布的端口同样受 fw 管控：需要 fw open 放行，黑名单、白名单也对容器生效"
	fi

	title "IP 白名单（始终放行所有端口）"
	local nalw ip
	nalw=$(grep -c . "$ALLOWS")
	if (( nalw == 0 )); then
		hint "（空）"
	else
		while read -r ip note; do
			[[ -z $ip ]] && continue
			printf "  %s%s\n" "$(pad "$ip" 44)" "$(note_text "$note")"
		done < "$ALLOWS"
		hint "共 $nalw 条，已放行 $(counter_of allowlist) 个数据包；fail2ban 不会封禁这些 IP"
	fi

	title "IP 黑名单"
	local nblk
	nblk=$(grep -c . "$BLOCKS")
	if (( nblk == 0 )); then
		hint "（空）"
	else
		local ip
		while read -r ip note; do
			[[ -z $ip ]] && continue
			printf "  %s%s\n" "$(pad "$ip" 44)" "$(note_text "$note")"
		done < "$BLOCKS"
		hint "共 $nblk 条，已拦截 $(counter_of blocklist) 个数据包"
	fi

	if command -v fail2ban-client >/dev/null; then
		title "fail2ban（SSH 防爆破）"
		local banned
		banned=$(f2b_banned | paste -sd' ')
		if [[ -n $banned ]]; then
			echo "  当前封禁 $(wc -w <<<"$banned") 个：$banned"
		else
			hint "当前没有封禁的 IP"
		fi
	fi
	echo
}

cmd_open() { # fw open 端口 [tcp|udp|both] [备注]
	local port proto note p ov changed=0 protos
	[[ -n $1 ]] || { err "用法：fw open <端口|区间> [tcp|udp|both] [备注]"; return 1; }
	port=$(norm_port "$1") || { err "端口格式不对：$1（应为 1-65535，或区间如 8000-8100）"; return 1; }
	proto=$(norm_proto "$2") || { err "协议应为 tcp、udp 或 both"; return 1; }
	note=${*:3}; note=${note//$'\t'/ }
	[[ $proto == both ]] && protos=(tcp udp) || protos=("$proto")

	save_state
	for p in "${protos[@]}"; do
		ov=$(find_overlap "$p" "$port" | paste -sd' ')
		if [[ $ov == "$port" ]]; then
			warn "$p/$port 已经是放行状态"; continue
		elif [[ -n $ov ]]; then
			warn "$p/$port 与已放行的 $ov 重叠，跳过"; continue
		fi
		echo "$p $port ${note:--}" >> "$PORTS"
		changed=1
	done
	if (( ! changed )); then discard_state; return 0; fi
	sort -k1,1 -k2,2n -o "$PORTS" "$PORTS"

	commit || return 1
	load_listeners
	local ctr
	for p in "${protos[@]}"; do
		grep -q "^$p $port " "$PORTS" || continue
		ok "已放行 $p/$port${note:+（$note）}"
		ctr=$(docker_ports | awk -v p="$p" -v lo="$(lo_of "$port")" -v hi="$(hi_of "$port")" \
			'$1 == p && $3 == "public" && $2 + 0 >= lo + 0 && $2 + 0 <= hi + 0 {print $4}' | sort -u | paste -sd,)
		if [[ -n $ctr ]]; then
			hint "  对应 Docker 容器：$ctr"
		elif [[ -z $(listeners_in "$p" "$(lo_of "$port")" "$(hi_of "$port")") ]]; then
			hint "  提示：目前没有程序监听 $p/$port，服务启动后外部才能连上"
		elif [[ -z $(listeners_in "$p" "$(lo_of "$port")" "$(hi_of "$port")" | awk '$2=="public"') ]]; then
			hint "  提示：程序只监听了 127.0.0.1，外部仍连不上，需要让它监听 0.0.0.0"
		fi
	done
}

cmd_close() { # fw close 端口 [tcp|udp|both]
	local port proto p ov changed=0 protos closed=()
	[[ -n $1 ]] || { err "用法：fw close <端口|区间> [tcp|udp|both]"; return 1; }
	port=$(norm_port "$1") || { err "端口格式不对：$1"; return 1; }
	proto=$(norm_proto "$2") || { err "协议应为 tcp、udp 或 both"; return 1; }
	[[ $proto == both ]] && protos=(tcp udp) || protos=("$proto")

	save_state
	for p in "${protos[@]}"; do
		if [[ $p == tcp ]] && is_ssh_port "$(lo_of "$port")" "$(hi_of "$port")"; then
			err "tcp/$port 包含 SSH 端口，关闭后将无法远程登录，已拒绝"; continue
		fi
		if grep -q "^$p $port " "$PORTS"; then
			awk -v p="$p" -v x="$port" '!($1 == p && $2 == x)' "$PORTS" > "$PORTS.tmp" && mv "$PORTS.tmp" "$PORTS"
			changed=1; closed+=("$p/$port")
		else
			ov=$(find_overlap "$p" "$port" | paste -sd' ')
			if [[ -n $ov ]]; then
				warn "$p/$port 属于已放行的区间 $ov，需要整段关闭：fw close $ov $p"
			else
				warn "$p/$port 本来就没有放行"
			fi
		fi
	done
	if (( ! changed )); then discard_state; return 0; fi

	commit || return 1
	for p in "${closed[@]}"; do ok "已关闭 $p"; done
	return 0
}

cmd_block() { # fw block IP [备注]
	local net note me
	[[ -n $1 ]] || { err "用法：fw block <IP|网段> [备注]"; return 1; }
	net=$(norm_net "$1") || { err "不是有效的 IP 或网段：$1"; return 1; }
	note=${*:2}; note=${note//$'\t'/ }
	for me in $(my_ips); do
		if net_contains "$net" "$me"; then
			err "$net 包含你当前登录用的 IP $me，封禁会把你自己踢下线，已拒绝"; return 1
		fi
	done
	if awk -v n="$net" '$1 == n {f = 1} END {exit !f}' "$BLOCKS"; then
		warn "$net 已经在黑名单里"; return 0
	fi
	local ov
	ov=$(find_net_overlap "$net" "$ALLOWS" | paste -sd' ')
	[[ -n $ov ]] && warn "$net 与白名单 $ov 重叠，重叠部分仍会被放行（白名单优先）"
	save_state
	echo "$net ${note:--}" >> "$BLOCKS"
	commit && ok "已封禁 $net${note:+（$note）}，该来源的所有入站连接都会被丢弃"
}

cmd_trust() { # fw trust IP [备注]
	local net note ov
	[[ -n $1 ]] || { err "用法：fw trust <IP|网段> [备注]"; return 1; }
	net=$(norm_net "$1") || { err "不是有效的 IP 或网段：$1"; return 1; }
	[[ $net == */0 ]] && { err "不能把所有地址加入白名单，那等于关闭防火墙"; return 1; }
	note=${*:2}; note=${note//$'\t'/ }
	if awk -v n="$net" '$1 == n {f = 1} END {exit !f}' "$ALLOWS"; then
		warn "$net 已经在白名单里"; return 0
	fi
	ov=$(find_net_overlap "$net" "$BLOCKS" | paste -sd' ')
	if [[ -n $ov ]]; then
		err "$net 与黑名单 $ov 冲突，请先解封：fw unblock ${ov%% *}"; return 1
	fi
	save_state
	echo "$net ${note:--}" >> "$ALLOWS"
	commit || return 1
	ok "已加入白名单 $net${note:+（$note）}，它可以访问本机所有端口"
	f2b_banned | while read -r ip; do
		net_contains "$net" "$ip" && fail2ban-client set sshd unbanip "$ip" >/dev/null && ok "已同时从 fail2ban 解封 $ip"
	done
	return 0
}

cmd_untrust() { # fw untrust IP
	local net
	[[ -n $1 ]] || { err "用法：fw untrust <IP|网段>"; return 1; }
	net=$(norm_net "$1") || { err "不是有效的 IP 或网段：$1"; return 1; }
	if ! awk -v n="$net" '$1 == n {f = 1} END {exit !f}' "$ALLOWS"; then
		warn "$net 不在白名单里"; return 0
	fi
	save_state
	awk -v n="$net" '$1 != n' "$ALLOWS" > "$ALLOWS.tmp" && mv "$ALLOWS.tmp" "$ALLOWS"
	commit && ok "已从白名单移除 $net，它的访问恢复按端口规则处理"
}

cmd_unblock() { # fw unblock IP
	local net
	[[ -n $1 ]] || { err "用法：fw unblock <IP|网段>"; return 1; }
	net=$(norm_net "$1") || { err "不是有效的 IP 或网段：$1"; return 1; }
	if awk -v n="$net" '$1 == n {f = 1} END {exit !f}' "$BLOCKS"; then
		save_state
		awk -v n="$net" '$1 != n' "$BLOCKS" > "$BLOCKS.tmp" && mv "$BLOCKS.tmp" "$BLOCKS"
		commit && ok "已从黑名单移除 $net"
	elif f2b_banned | grep -qxF "$net"; then
		fail2ban-client set sshd unbanip "$net" >/dev/null && ok "已从 fail2ban 解封 $net"
	else
		warn "$net 不在黑名单里，也没有被 fail2ban 封禁"
	fi
}

cmd_log() { # fw log [条数]
	local n=${1:-20} lines
	[[ $n =~ ^[0-9]+$ ]] || n=20
	lines=$(journalctl -k --no-pager -o short-iso --since -24h 2>/dev/null | grep 'nft-drop: ')
	title "最近 $n 条拦截记录"
	hint "抽样记录，每分钟最多 5 条，不代表全部拦截"
	if [[ -z $lines ]]; then hint "过去 24 小时没有记录"; echo; return; fi
	printf "  ${D}%s%s%s%s${N}\n" "$(pad 时间 17)" "$(pad "来源 IP" 42)" "$(pad 协议 7)" "目标端口"
	tail -n "$n" <<<"$lines" | awk '{
		t = substr($1, 6, 5) " " substr($1, 12, 8); src = proto = dpt = ""
		for (i = 1; i <= NF; i++) {
			if ($i ~ /^SRC=/) src = substr($i, 5)
			else if ($i ~ /^PROTO=/) proto = tolower(substr($i, 7))
			else if ($i ~ /^DPT=/) dpt = substr($i, 5)
		}
		printf "  %-17s%-42s%-7s%s\n", t, src, proto, (dpt == "" ? "-" : dpt) }'

	title "过去 24 小时被探测最多的端口"
	awk '{ proto = dpt = ""
		for (i = 1; i <= NF; i++) {
			if ($i ~ /^PROTO=/) proto = tolower(substr($i, 7))
			else if ($i ~ /^DPT=/) dpt = substr($i, 5)
		}
		if (dpt != "") print proto "/" dpt }' <<<"$lines" | sort | uniq -c | sort -rn | head -10 |
		awk '{ printf "  %5d 次  %s\n", $1, $2 }'
	echo
}

cmd_bans() {
	command -v fail2ban-client >/dev/null || { warn "未安装 fail2ban"; return 1; }
	local st
	st=$(fail2ban-client status sshd 2>/dev/null) || { warn "fail2ban 未运行"; return 1; }
	title "fail2ban（SSH 防爆破）"
	local cf tf cb tb
	cf=$(sed -n 's/.*Currently failed:\s*//p' <<<"$st")
	tf=$(sed -n 's/.*Total failed:\s*//p' <<<"$st")
	cb=$(sed -n 's/.*Currently banned:\s*//p' <<<"$st")
	tb=$(sed -n 's/.*Total banned:\s*//p' <<<"$st")
	echo "  登录失败  当前统计中 $cf 次，累计 $tf 次"
	echo "  封禁      当前 $cb 个，累计 $tb 个"
	local i=0 ip
	while read -r ip; do
		[[ -z $ip ]] && continue
		printf "  %s) %s\n" "$((++i))" "$ip"
	done < <(f2b_banned)
	hint "规则：10 分钟内失败 5 次封 1 小时，再犯时间递增，最长 1 周"
	echo
}

cmd_reload() {
	apply && ok "已重新加载防火墙规则"
}

cmd_help() {
	cat <<EOF
${BD}fw —— 防火墙管理${N}

  fw                              进入交互菜单
  fw status                       查看防火墙状态（默认）
  fw open  <端口> [协议] [备注]   放行端口，例：fw open 443 tcp nginx
                                  区间：fw open 8000-8100   双协议：fw open 53 both dns
  fw close <端口> [协议]          关闭端口，例：fw close 443
  fw block <IP|网段> [备注]       封禁来源，例：fw block 1.2.3.0/24 扫描
  fw unblock <IP|网段>            解封（也能解封 fail2ban 封的 IP）
  fw trust <IP|网段> [备注]       加入白名单，始终放行所有端口，例：fw trust 1.2.3.4 公司
  fw untrust <IP|网段>            移出白名单
  fw log [条数]                   查看拦截日志和被探测最多的端口
  fw bans                         查看 fail2ban 封禁情况
  fw reload                       按 $FW_DIR/ 中的规则重新加载

  协议：tcp（默认）、udp、both
  所有修改立即生效并永久保存；SSH 端口受保护，不能关闭。
EOF
}

# ---------- 交互菜单 ----------

ask() { # ask 变量名 提示 [默认值]
	local __a
	read -e -rp "  $2" __a || { echo; return 1; }
	printf -v "$1" '%s' "${__a:-$3}"
}
confirm() { # 默认 Yes
	local a
	read -rp "  $1 [Y/n] " a || return 1
	[[ -z $a || $a =~ ^[Yy] ]]
}
FW_UI_MODE=0
ui_stdout_tty() { [[ -t 1 ]]; }
ui_clear() {
	[[ ${FW_UI_MODE:-0} == 1 && ${FW_NO_CLEAR:-0} != 1 && ${TERM:-dumb} != dumb ]] && ui_stdout_tty || return 0
	if command -v clear >/dev/null 2>&1 && clear -x 2>/dev/null; then return 0; fi
	printf '\e[H\e[2J\e[3J'
}
pause() { local _; printf '  %s按回车返回菜单…%s' "$D" "$N"; read -rs _ || true; echo; }

ui_open() {
	ui_clear
	title "放行端口"
	load_listeners
	local l lp lport lscope lproc shown=0
	for l in "${LISTENERS[@]}"; do
		read -r lp lport lscope lproc <<<"$l"
		[[ $lscope == public && $lproc != docker-proxy ]] || continue
		port_open "$lp" "$lport" && continue
		(( shown++ )) || hint "以下端口有程序在监听，但还没放行："
		hint "  $lp/$lport  $lproc"
	done
	local port proto note
	ask port "端口（如 8080，或区间 8000-8100，回车取消）: " || return
	[[ -z $port ]] && return
	norm_port "$port" >/dev/null || { err "端口格式不对：$port"; return; }
	echo "  协议：${BD}1${N}) TCP   ${BD}2${N}) UDP   ${BD}3${N}) TCP+UDP"
	ask proto "选择 [1]: " 1 || return
	proto=$(norm_proto "$proto") || { err "无效的选择"; return; }
	ask note "备注（可选，如 nginx）: " || return
	echo
	cmd_open "$port" "$proto" "$note"
}

ui_close() {
	ui_clear
	title "关闭端口"
	local rows=() row i=0 proto port note
	mapfile -t rows < <(grep . "$PORTS")
	for row in "${rows[@]}"; do
		read -r proto port note <<<"$row"
		if [[ $proto == tcp ]] && is_ssh_port "$(lo_of "$port")" "$(hi_of "$port")"; then
			printf "  ${D}%2d) %s%s%s${N}\n" "$((++i))" "$(pad "$proto" 6)" "$(pad "$port" 13)" "$(note_text "$note") (受保护，不可关闭)"
		else
			printf "  %2d) %s%s%s\n" "$((++i))" "$(pad "$proto" 6)" "$(pad "$port" 13)" "$(note_text "$note")"
		fi
	done
	local sel picks=() n
	ask sel "输入要关闭的编号（多个用空格分隔，回车取消）: " || return
	[[ -z $sel ]] && return
	for n in ${sel//,/ }; do
		if [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#rows[@]} )); then
			picks+=("${rows[n-1]}")
		else
			err "无效编号：$n"; return
		fi
	done
	local list
	list=$(for row in "${picks[@]}"; do read -r proto port _ <<<"$row"; echo -n "$proto/$port "; done)
	confirm "确认关闭 ${BD}${list% }${N}？" || return
	echo
	for row in "${picks[@]}"; do
		read -r proto port _ <<<"$row"
		cmd_close "$port" "$proto"
	done
}

ui_block() {
	ui_clear
	title "封禁 IP"
	hint "支持单个 IP（1.2.3.4）或网段（1.2.3.0/24、2001:db8::/32）"
	local ip note
	ask ip "IP 或网段（回车取消）: " || return
	[[ -z $ip ]] && return
	norm_net "$ip" >/dev/null || { err "不是有效的 IP 或网段：$ip"; return; }
	ask note "备注（可选）: " || return
	confirm "确认封禁 ${BD}$ip${N}？" || return
	echo
	cmd_block "$ip" "$note"
}

ui_unblock() {
	ui_clear
	title "解封 IP"
	local rows=() row i=0 ip note
	mapfile -t rows < <(awk 'NF {print $1, "黑名单", $0}' "$BLOCKS"; f2b_banned | awk '{print $1, "fail2ban"}')
	if (( ${#rows[@]} == 0 )); then hint "黑名单和 fail2ban 里都没有封禁的 IP"; return; fi
	for row in "${rows[@]}"; do
		read -r ip src _ note <<<"$row"
		printf "  %2d) %s%s%s\n" "$((++i))" "$(pad "$ip" 44)" "$(pad "$src" 10)" "$(note_text "${note:--}")"
	done
	local sel n
	ask sel "输入要解封的编号（多个用空格分隔，回车取消）: " || return
	[[ -z $sel ]] && return
	echo
	for n in ${sel//,/ }; do
		if [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#rows[@]} )); then
			read -r ip _ <<<"${rows[n-1]}"
			cmd_unblock "$ip"
		else
			err "无效编号：$n"
		fi
	done
}

ui_trust() {
	ui_clear
	title "添加白名单（始终放行）"
	hint "白名单里的 IP 可以访问本机所有端口，也不会被 fail2ban 封禁"
	local me
	me=$(my_ips | paste -sd' ')
	[[ -n $me ]] && hint "你当前登录用的 IP：$me（家用宽带的 IP 通常会变，不建议长期依赖）"
	local ip note
	ask ip "IP 或网段（回车取消）: " || return
	[[ -z $ip ]] && return
	norm_net "$ip" >/dev/null || { err "不是有效的 IP 或网段：$ip"; return; }
	ask note "备注（可选，如 公司、家里）: " || return
	confirm "确认让 ${BD}$ip${N} 访问所有端口？" || return
	echo
	cmd_trust "$ip" "$note"
}

ui_untrust() {
	ui_clear
	title "移出白名单"
	local rows=() row i=0 ip note
	mapfile -t rows < <(grep . "$ALLOWS")
	if (( ${#rows[@]} == 0 )); then hint "白名单是空的"; return; fi
	for row in "${rows[@]}"; do
		read -r ip note <<<"$row"
		printf "  %2d) %s%s\n" "$((++i))" "$(pad "$ip" 44)" "$(note_text "$note")"
	done
	local sel n
	ask sel "输入要移除的编号（多个用空格分隔，回车取消）: " || return
	[[ -z $sel ]] && return
	echo
	for n in ${sel//,/ }; do
		if [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#rows[@]} )); then
			read -r ip _ <<<"${rows[n-1]}"
			cmd_untrust "$ip"
		else
			err "无效编号：$n"
		fi
	done
}

menu() {
	trap 'echo; exit 130' INT
	local c nports nblk nalw nban FW_UI_MODE=1
	while true; do
		nports=$(grep -c . "$PORTS")
		nblk=$(grep -c . "$BLOCKS")
		nalw=$(grep -c . "$ALLOWS")
		nban=$(f2b_banned | grep -c .)
		ui_clear
		echo
		echo "  ${BD}${C}fw 防火墙管理${N}   ${D}$(hostname)${N}"
		if nft list table inet host >/dev/null 2>&1; then
			echo "  ${G}● 运行中${N}  放行 ${BD}$nports${N} 个端口 · 白名单 ${BD}$nalw${N} · 黑名单 ${BD}$nblk${N} · fail2ban 封禁 ${BD}$nban${N}"
		else
			echo "  ${R}● 未加载${N}  （选 r 重新加载）"
		fi
		echo "  ${D}──────────────────────────────────────${N}"
		echo "   ${BD}1${N}) 查看状态        ${BD}6${N}) 添加白名单"
		echo "   ${BD}2${N}) 放行端口        ${BD}7${N}) 移出白名单"
		echo "   ${BD}3${N}) 关闭端口        ${BD}8${N}) 拦截日志"
		echo "   ${BD}4${N}) 封禁 IP         ${BD}9${N}) fail2ban 情况"
		echo "   ${BD}5${N}) 解封 IP         ${BD}r${N}) 重新加载规则"
		echo "   ${BD}0${N}) 退出"
		echo
		read -rp "  请选择: " c || { echo; exit 0; }
		case $c in
			1) ui_clear; cmd_status; pause ;;
			2) ui_open; echo; pause ;;
			3) ui_close; echo; pause ;;
			4) ui_block; echo; pause ;;
			5) ui_unblock; echo; pause ;;
			6) ui_trust; echo; pause ;;
			7) ui_untrust; echo; pause ;;
			8) ui_clear; cmd_log 30; pause ;;
			9) ui_clear; cmd_bans; pause ;;
			r|R) ui_clear; echo; cmd_reload; echo; pause ;;
			0|q|Q|'') echo; exit 0 ;;
			*) ;;
		esac
	done
}

# ---------- 入口 ----------

init_state
cmd=${1:-}
shift 2>/dev/null
case $cmd in
	'')               if [[ -t 0 && -t 1 ]]; then menu; else cmd_status; fi ;;
	status|s|st)      cmd_status ;;
	open|allow|o)     if [[ -z $1 && -t 0 ]]; then ui_open; else cmd_open "$@"; fi ;;
	close|deny|c)     if [[ -z $1 && -t 0 ]]; then ui_close; else cmd_close "$@"; fi ;;
	block|ban|b)      if [[ -z $1 && -t 0 ]]; then ui_block; else cmd_block "$@"; fi ;;
	unblock|unban|u)  if [[ -z $1 && -t 0 ]]; then ui_unblock; else cmd_unblock "$@"; fi ;;
	trust|t)          if [[ -z $1 && -t 0 ]]; then ui_trust; else cmd_trust "$@"; fi ;;
	untrust|ut)       if [[ -z $1 && -t 0 ]]; then ui_untrust; else cmd_untrust "$@"; fi ;;
	log|logs|l)       cmd_log "$@" ;;
	bans|f2b)         cmd_bans ;;
	reload|r)         cmd_reload ;;
	help|-h|--help)   cmd_help ;;
	*)                err "未知命令：$cmd"; cmd_help; exit 1 ;;
esac
